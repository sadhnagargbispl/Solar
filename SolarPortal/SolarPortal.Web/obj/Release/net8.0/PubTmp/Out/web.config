<?xml version="1.0" encoding="utf-8"?>
<!--
  Publish merges the ASP.NET Core handler / aspNetCore element into this file.
  It exists only to lift IIS's own request cap (default ~30 MB): the INC upload
  format posts up to 39 photos plus a structure/wiring video in one request
  (InstallationController.MarkComplete / Resubmit allow up to 1 GB).
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="1073741824" />
      </requestFiltering>
    </security>
    <handlers>
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>
    <aspNetCore processPath="dotnet" arguments=".\SolarPortal.Web.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
  </system.webServer>
</configuration>

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // Razor runtime compilation (hot-reload of .cshtml without a rebuild) is OFF on
  // this machine. The project lives on a network share (\\localhost\Sadhna\...),
  // and the content-root walk it does at startup stalls there: the app then never
  // reaches Kestrel and hangs with no log line at all. Verified both ways - false
  // starts in ~3 seconds, true never binds.
  //
  // Cost: a .cshtml edit needs a rebuild (same as Release). Flip to true if the
  // project ever moves to a local disk.
  "RazorRuntimeCompilation": false
}

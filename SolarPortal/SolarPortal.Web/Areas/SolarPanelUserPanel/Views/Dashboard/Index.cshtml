@model UserDashboardDto
@{
    ViewData["Title"] = "My Dashboard";
    var subTotal = (decimal)(ViewBag.TotalSubmitted ?? 0m);
    var verTotal = (decimal)(ViewBag.VerifiedPaid ?? 0m);
    var minVal   = (decimal)(ViewBag.Minimum ?? 20000m);

    string StageStsClass(Domain.Enums.ProjectStatus s) => s switch
    {
        Domain.Enums.ProjectStatus.Completed => "sts-act",
        Domain.Enums.ProjectStatus.MeterDispatch => "sts-disp",
        Domain.Enums.ProjectStatus.Installation => "sts-disp",
        _ => "sts-pend"
    };
    string ApprovalStsClass(Domain.Enums.ApprovalStatus s) => s switch
    {
        Domain.Enums.ApprovalStatus.Approved => "sts-act",
        Domain.Enums.ApprovalStatus.Rejected => "sts-rej",
        _ => "sts-pend"
    };
}

<div class="page active">
    <div class="ph">
        <div class="ph-bc">👤 User / <span>Dashboard</span></div>
        <div class="ph-title">My Solar Dashboard</div>
        <div class="ph-sub">Welcome back! Track your solar connection status here.</div>
    </div>

    <div class="g4" style="margin-bottom:18px">
        <div class="sc">
            <div class="sc-label">My Projects</div>
            <div class="sc-val gold">@Model.TotalProjects</div>
            <div class="sc-sub">Active applications</div>
        </div>
        <div class="sc">
            <div class="sc-label">Pending Approvals</div>
            <div class="sc-val blue">@Model.PendingApprovals</div>
            <div class="sc-sub">Awaiting admin</div>
        </div>
        <div class="sc">
            <div class="sc-label">Total Paid</div>
            <div class="sc-val green">₹@Model.TotalPaid.ToString("N0")</div>
            <div class="sc-sub">Across all projects</div>
        </div>
        <div class="sc">
            <div class="sc-label">Due Amount</div>
            <div class="sc-val red">₹@Model.TotalDue.ToString("N0")</div>
            <div class="sc-sub">Balance remaining</div>
        </div>
    </div>

    @if (Model.LatestProject == null)
    {
        <div class="card text-center" style="padding:40px">
            <h3>No active project yet</h3>
            <p class="text-muted">You haven't submitted a solar request. Get started below.</p>
            <a class="btn btn-p" asp-area="SolarPanelUserPanel" asp-controller="SolarRequest" asp-action="Create">➕ Start a New Request</a>
        </div>
    }
    else
    {
        <div class="g2" style="grid-template-columns:1.4fr 1fr;gap:14px">
            <div>
                <partial name="~/Views/Shared/_StatusTimeline.cshtml" model="Model.LatestProject" />
            </div>
            <div>
                <div class="card" style="margin-bottom:14px">
                    <div class="ct"><span class="ct-dot"></span>Next Action</div>
                    @{
                        switch (Model.LatestProject.CurrentStage)
                        {
                            case SolarPortal.Domain.Enums.ProjectStatus.Registration:
                            case SolarPortal.Domain.Enums.ProjectStatus.ProductSelection:
                                <h6>🛒 Select Plan & Make Payment</h6>
                                <p class="text-muted" style="font-size:13px">Choose your solar kit (1 kW, 2 kW, etc.) and submit your first payment. <strong>Admin must verify</strong> before workflow advances.</p>
                                <a class="btn btn-p btn-full" asp-area="SolarPanelUserPanel" asp-controller="SolarRequest" asp-action="Create">Solar Request & Payment</a>
                                break;
                            case SolarPortal.Domain.Enums.ProjectStatus.Payment:
                                <h6>💰 Make a Payment</h6>
                                <p class="text-muted" style="font-size:13px">Submit at least ₹@minVal.ToString("N0") cumulative. <strong>Admin must verify</strong> before workflow advances.</p>
                                if (subTotal > 0 || verTotal > 0)
                                {
                                    <div class="card" style="background:var(--bg);padding:10px;margin:10px 0;font-size:12.5px;box-shadow:none">
                                        <div class="sr"><span class="srk">Submitted</span><span class="srv">₹@subTotal.ToString("N0")</span></div>
                                        <div class="sr"><span class="srk" style="color:var(--green)">Admin Verified</span><span class="srv" style="color:var(--green)">₹@verTotal.ToString("N0")</span></div>
                                        <div class="sr"><span class="srk">Minimum to Advance</span><span class="srv">₹@minVal.ToString("N0")</span></div>
                                    </div>
                                    if (verTotal >= minVal)
                                    {
                                        <div class="alert alert-s" style="font-size:12px"><span class="ai">✅</span>Verified total meets minimum.</div>
                                    }
                                    else if (subTotal >= minVal)
                                    {
                                        <div class="alert alert-w" style="font-size:12px"><span class="ai">⏳</span>Awaiting admin to verify ₹@((minVal - verTotal).ToString("N0")) more.</div>
                                    }
                                }
                                <a class="btn btn-p btn-full" asp-area="SolarPanelUserPanel" asp-controller="SolarRequest" asp-action="Payment" asp-route-id="@Model.LatestProject.Id">Go to Payment</a>
                                break;
                            case SolarPortal.Domain.Enums.ProjectStatus.PMSurvey:
                                <h6>📋 Upload PM Surya Ghar Documents</h6>
                                <p class="text-muted" style="font-size:13px">Upload the required scheme documents for admin verification.</p>
                                <a class="btn btn-p btn-full" asp-area="SolarPanelUserPanel" asp-controller="PMSurya" asp-action="Upload" asp-route-id="@Model.LatestProject.Id">Upload Documents</a>
                                break;
                            case SolarPortal.Domain.Enums.ProjectStatus.SiteSurvey:
                                <h6>📐 Site Survey</h6>
                                <p class="text-muted" style="font-size:13px">Download form, fill on site, then upload back with photos.</p>
                                <a class="btn btn-p btn-full" asp-area="SolarPanelUserPanel" asp-controller="SiteSurvey" asp-action="Index" asp-route-id="@Model.LatestProject.Id">Go to Site Survey</a>
                                break;
                            case SolarPortal.Domain.Enums.ProjectStatus.MeterDispatch:
                                <h6>⚡ Awaiting Meter Dispatch</h6>
                                <p class="text-muted" style="font-size:13px">Admin is preparing your meter. Check back for updates.</p>
                                break;
                            case SolarPortal.Domain.Enums.ProjectStatus.MaterialDispatch:
                                <h6>📦 Awaiting Material Dispatch</h6>
                                <p class="text-muted" style="font-size:13px">Solar material is being dispatched to your address.</p>
                                break;
                            case SolarPortal.Domain.Enums.ProjectStatus.Installation:
                                <h6>🔧 Installation In Progress</h6>
                                <p class="text-muted" style="font-size:13px">An installer (INC) has been assigned. They'll update progress here.</p>
                                break;
                            case SolarPortal.Domain.Enums.ProjectStatus.DCRUpdate:
                                <h6>📄 Upload DCR Document</h6>
                                <p class="text-muted" style="font-size:13px">Final step — upload your DCR document for admin verification.</p>
                                <a class="btn btn-p btn-full" asp-area="SolarPanelUserPanel" asp-controller="DCR" asp-action="Upload" asp-route-id="@Model.LatestProject.Id">Upload DCR</a>
                                break;
                            case SolarPortal.Domain.Enums.ProjectStatus.Completed:
                                <h6>✅ Project Complete</h6>
                                <p style="color:var(--green);font-size:13px">Your solar installation is fully complete!</p>
                                break;
                        }
                    }
                </div>

                <div class="card">
                    <div class="ct"><span class="ct-dot"></span>Project Info</div>
                    @{
                        // The auto-stub is "empty" until the user actually fills the
                        // New Request form — no plan picked, KV=0, amount=0. Showing
                        // "With Activation / Domestic / ₹0 / 0.00 kV" then looks like
                        // real saved values which is misleading. Show "Not selected yet"
                        // placeholders instead.
                        var isEmptyStub = !Model.LatestProject.SolarProjectId.HasValue
                                          && Model.LatestProject.KVCapacity == 0
                                          && Model.LatestProject.RequestedAmount == 0;
                    }
                    <div class="sr"><span class="srk">Project</span><span class="srv">@Model.LatestProject.RequestNumber</span></div>

                    @if (isEmptyStub)
                    {
                        <div class="sr"><span class="srk">Mode</span><span class="srv" style="color:#94a3b8;font-style:italic">Not selected yet</span></div>
                        <div class="sr"><span class="srk">Plan</span><span class="srv" style="color:#94a3b8;font-style:italic">Not selected yet</span></div>
                        <div class="sr"><span class="srk">Capacity</span><span class="srv" style="color:#94a3b8;font-style:italic">—</span></div>
                        <div class="sr"><span class="srk">Connection</span><span class="srv" style="color:#94a3b8;font-style:italic">Not selected yet</span></div>
                        <div class="sr"><span class="srk">Total Amount</span><span class="srv" style="color:#94a3b8;font-style:italic">—</span></div>
                    }
                    else
                    {
                        <div class="sr"><span class="srk">Mode</span><span class="srv">
                            @switch (Model.LatestProject.RequestType)
                            {
                                case SolarPortal.Domain.Enums.RequestType.WithActivation: <text>🔌 With Activation</text>; break;
                                case SolarPortal.Domain.Enums.RequestType.OnlySolarWithoutActivation: <text>⚡ Only Solar</text>; break;
                                case SolarPortal.Domain.Enums.RequestType.AlreadyActiveOnlyRequest: <text>✅ Already Active</text>; break;
                            }
                        </span></div>
                        <div class="sr"><span class="srk">Plan</span><span class="srv">@(string.IsNullOrWhiteSpace(Model.LatestProject.SelectedPlan) ? "—" : Model.LatestProject.SelectedPlan)</span></div>
                        <div class="sr"><span class="srk">Capacity</span><span class="srv">@(Model.LatestProject.KVCapacity > 0 ? $"{Model.LatestProject.KVCapacity} kV" : "—")</span></div>
                        <div class="sr"><span class="srk">Connection</span><span class="srv">@Model.LatestProject.ConnectionType</span></div>
                        <div class="sr"><span class="srk">Total Amount</span><span class="srv">@(Model.LatestProject.RequestedAmount > 0 ? "₹" + Model.LatestProject.RequestedAmount.ToString("N0") : "—")</span></div>
                    }

                    <div class="sr"><span class="srk">Stage</span><span class="srv"><span class="sts @StageStsClass(Model.LatestProject.CurrentStage)">@Model.LatestProject.CurrentStage</span></span></div>
                    <div class="sr"><span class="srk">Approval</span><span class="srv"><span class="sts @ApprovalStsClass(Model.LatestProject.ApprovalStatus)">@Model.LatestProject.ApprovalStatus</span></span></div>
                </div>
            </div>
        </div>

        @if (Model.MyProjects.Count > 1)
        {
            <div class="card" style="margin-top:14px">
                <div class="ct"><span class="ct-dot"></span>All My Projects</div>
                <div class="tbl-wrap">
                    <table>
                        <thead>
                            <tr><th>ID</th><th>Type</th><th>kV</th><th>Stage</th><th>Status</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.MyProjects)
                            {
                                <tr>
                                    <td class="td-b">
                                        <a asp-area="SolarPanelUserPanel" asp-controller="SolarRequest" asp-action="Details" asp-route-id="@p.Id" style="color:var(--accent)">@p.RequestNumber</a>
                                    </td>
                                    <td>@p.ConnectionType</td>
                                    <td>@p.KVCapacity kV</td>
                                    <td><span class="sts @StageStsClass(p.CurrentStage)">@p.CurrentStage</span></td>
                                    <td><span class="sts @ApprovalStsClass(p.ApprovalStatus)">@p.ApprovalStatus</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>

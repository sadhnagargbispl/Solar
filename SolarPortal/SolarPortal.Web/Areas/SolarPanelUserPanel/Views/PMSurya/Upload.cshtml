@{
    ViewData["Title"] = "PM Surya Ghar Documents";
    var req = (SolarPortal.Domain.Entities.SolarRequest)ViewBag.Request;
    var docs = (IEnumerable<SolarPortal.Application.DTOs.PMDocumentDto>)ViewBag.Documents;
    var isLocked = (int)req.CurrentStage > (int)SolarPortal.Domain.Enums.ProjectStatus.PMSurvey;

    var loanOpt   = req.PMSuryaLoanOption;

    // The ADMIN panel (separate app, shared DB) saves its approval uploads with
    // DocumentType 11-14 and/or under a "pmsurya-approval" folder, without setting
    // IsAdminUpload - detect all three markers so they show as admin documents.
    bool IsAdminDoc(SolarPortal.Application.DTOs.PMDocumentDto x) =>
        x.IsAdminUpload
        || ((int)x.DocumentType >= 11 && (int)x.DocumentType <= 14)
        || (x.FilePath != null && x.FilePath.IndexOf("pmsurya-approval", StringComparison.OrdinalIgnoreCase) >= 0);
    var adminDocs = docs.Where(x => IsAdminDoc(x)).ToList();
    var userDocs  = docs.Where(x => !IsAdminDoc(x)).ToList();

    // PM Surya Ghar ID: this app writes PMSuryaGharIdNo, the admin app writes PmSuryaApplicationNo.
    var pmGharId = !string.IsNullOrWhiteSpace(req.PMSuryaGharIdNo) ? req.PMSuryaGharIdNo : req.PmSuryaApplicationNo;

    var requiredDocs = new[]
    {
        new { Type = "AadharCard",       Label = "Aadhaar Card",                                Icon = "🪪" },
        new { Type = "PANCard",          Label = "PAN Card",                                    Icon = "💳" },
        new { Type = "LightBill",        Label = "Light Bill (Last 3 Months)",                  Icon = "💡" },
        new { Type = "BankPassbook",     Label = "Cancelled Cheque / Passbook",                 Icon = "🏦" },
        new { Type = "PropertyDocument", Label = "Property Document (Farad / पट्टा / Registry)", Icon = "🏠" },
        new { Type = "GPSPhoto",         Label = "GPS / Location Photo",                        Icon = "📍" },
        new { Type = "Photo",            Label = "Applicant Photo",                             Icon = "📷" },
        new { Type = "Signature",        Label = "Signature",                                   Icon = "✍️" }
    };
    var doneCount = requiredDocs.Count(d => userDocs.Any(x => x.DocumentType.ToString() == d.Type));
    var totalCount = requiredDocs.Length;
    var pct = totalCount > 0 ? (int)Math.Round(doneCount * 100.0 / totalCount) : 0;

    // Submit is only allowed while something is actually pending admin review.
    var hasPending  = userDocs.Any(x => x.Status == SolarPortal.Domain.Enums.ApprovalStatus.Pending);
    var hasRejected = userDocs.Any(x => x.Status == SolarPortal.Domain.Enums.ApprovalStatus.Rejected);

    // A document counts as SUBMITTED once it was part of a "Submit for Admin
    // Verification" press - i.e. it has not been touched since PMSuryaSubmittedAt.
    // Those files are with the admin. Anything newer (or uploaded before the user
    // ever submitted) is still the user's own draft and stays replaceable.
    bool IsSubmitted(SolarPortal.Application.DTOs.PMDocumentDto x) =>
        req.PMSuryaSubmittedAt.HasValue && (x.UpdatedAt ?? x.CreatedAt) <= req.PMSuryaSubmittedAt.Value;

    // Something worth sending to the admin: pending AND not already submitted.
    var hasUnsubmitted = userDocs.Any(x =>
        x.Status == SolarPortal.Domain.Enums.ApprovalStatus.Pending && !IsSubmitted(x));

    string StsClass(SolarPortal.Domain.Enums.ApprovalStatus s) => s switch
    {
        SolarPortal.Domain.Enums.ApprovalStatus.Approved => "sts-act",
        SolarPortal.Domain.Enums.ApprovalStatus.Rejected => "sts-rej",
        _ => "sts-pend"
    };
}

<div class="page active">
    <div class="ph">
        <div class="ph-bc">User / <span>PM Surya Ghar</span></div>
        <div class="ph-title">PM Surya Ghar Documents &mdash; @req.RequestNumber</div>
        <div class="ph-sub">Upload the required scheme documents. Once submitted, an admin will verify them.</div>
    </div>

    <div class="g2" style="grid-template-columns:1.5fr 1fr;gap:16px;align-items:start">
        <div>
            <div class="card">
                <div class="ct"><span class="ct-dot"></span>Loan Preference</div>
                @* Once admin has verified the PM Surya stage the loan choice is part of
                   that approved submission - show it, but no longer let the user change it. *@
                @if (isLocked)
                {
                    <p class="text-muted" style="font-size:13.5px;margin-bottom:12px">
                        Your loan preference for this PM Surya Ghar installation:
                    </p>
                    <div class="loan-seg loan-locked">
                        <span class="sts @(string.IsNullOrWhiteSpace(loanOpt) ? "sts-pend" : "sts-act")">
                            @(loanOpt == "Loan" ? "On Loan" : loanOpt == "WithoutLoan" ? "Without Loan" : "Not selected")
                        </span>
                    </div>
                    <div class="hint" style="margin-top:10px">Locked - admin has verified this stage. Please contact admin to change your loan preference.</div>
                }
                else
                {
                    <p class="text-muted" style="font-size:13.5px;margin-bottom:12px">
                        Do you want to avail this PM Surya Ghar installation on <strong>Loan</strong> or <strong>Without Loan</strong>?
                    </p>
                    <div class="loan-seg">
                        <button type="button" class="btn @(loanOpt == "Loan" ? "btn-success" : "btn-outline-success") loan-opt" data-opt="Loan">On Loan</button>
                        <button type="button" class="btn @(loanOpt == "WithoutLoan" ? "btn-success" : "btn-outline-success") loan-opt" data-opt="WithoutLoan">Without Loan</button>
                        <span id="loanSavedMsg" class="text-success" style="font-size:13px;align-self:center"></span>
                    </div>
                }
            </div>

            <div class="card">
                <div class="ct" style="justify-content:space-between">
                    <span style="display:flex;align-items:center;gap:9px"><span class="ct-dot"></span>Upload Documents</span>
                    <span style="font-size:12.5px;color:var(--text2);font-weight:500">@doneCount / @totalCount uploaded</span>
                </div>

                <div class="prog-wrap" style="margin-top:0">
                    <div class="prog-bar" style="width:@pct%"></div>
                </div>

                @foreach (var d in requiredDocs)
                {
                    var uploaded = userDocs.FirstOrDefault(x => x.DocumentType.ToString() == d.Type);
                    <div class="pm-doc @(uploaded != null ? "done" : "")">
                        <div class="pm-doc-ic">@d.Icon</div>
                        <div class="pm-doc-body">
                            <div class="pm-doc-name">@d.Label</div>
                            <div class="pm-doc-sub">
                                @if (uploaded == null) { <text>Not uploaded yet</text> }
                                else if (uploaded.Status == SolarPortal.Domain.Enums.ApprovalStatus.Pending && !IsSubmitted(uploaded)) { <text>Uploaded - not submitted yet</text> }
                                else { <text>Uploaded</text> }
                            </div>                            @if (uploaded != null && !string.IsNullOrWhiteSpace(uploaded.Remarks))
                            {
                                <div class="pm-doc-remark">Admin remark: @uploaded.Remarks</div>
                            }
                        </div>
                        @if (uploaded != null)
                        {
                            <span class="sts @StsClass(uploaded.Status)">@uploaded.Status</span>
                        }
                        <div class="pm-doc-act">
                            @{
                                // A REJECTED document is ALWAYS replaceable - the stage lock does
                                // not apply to it. Admin explicitly asked for a different file, so
                                // hiding Replace behind isLocked (stage moved past PM Survey) left
                                // the user with no way to comply. Re-uploading only resets THAT
                                // document to Pending and clears the reject remark
                                // (PMDocumentService.UploadDocumentAsync); the request's stage is
                                // never touched.
                                //
                                // Everything else keeps the old rule: upload when nothing is there,
                                // and replace an uploaded-but-not-yet-submitted draft. Once
                                // submitted or approved the file is with the admin.
                                var canUpload =
                                    uploaded?.Status == SolarPortal.Domain.Enums.ApprovalStatus.Rejected
                                    || (!isLocked && (uploaded == null
                                        || (uploaded.Status == SolarPortal.Domain.Enums.ApprovalStatus.Pending
                                            && !IsSubmitted(uploaded))));
                            }
                            @if (canUpload)
                            {
                                <input type="file" class="d-none pm-file" id="file-@d.Type" data-type="@d.Type" accept=".pdf,.png,.jpg,.jpeg" style="display:none" />
                                @if (d.Type == "Photo")
                                {
                                    <button type="button" class="btn btn-sm btn-p" onclick="openLivePhoto()">📷 Live Photo</button>
                                }
                                @if (d.Type == "Signature")
                                {
                                    <button type="button" class="btn btn-sm btn-p" onclick="openSignaturePad()">✍️ Draw</button>
                                }
                                <button class="btn btn-sm @(uploaded != null ? "btn-s" : "btn-p") pm-pick" data-target="file-@d.Type">
                                    @(uploaded != null ? "Replace" : "Upload")
                                </button>
                            }
                            @if (uploaded != null)
                            {
                                <a href="javascript:void(0)" onclick="openFileModal('@uploaded.FilePath')" class="btn btn-sm btn-s">View</a>
                            }
                        </div>
                    </div>
                }

                @if (isLocked && hasRejected)
                {
                    @* Stage has moved on but admin rejected a document - say so plainly
                       instead of claiming everything is verified. *@
                    <div class="alert alert-w" style="margin:14px 0 0">
                        <span class="ai">!</span>
                        <div>
                            <strong>A document was rejected.</strong> Upload it again using the
                            <em>Replace</em> button above - it goes straight back to admin for review.
                            Your project stage stays exactly where it is.
                        </div>
                    </div>
                }
                else if (isLocked)
                {
                    <div class="alert alert-s" style="margin:14px 0 0">
                        <span class="ai">OK</span>
                        <div><strong>Approved &amp; Locked.</strong> Admin has verified all PM Surya Ghar documents. This stage is complete.</div>
                    </div>
                }
                else
                {
                    <button id="btnSubmit" class="btn btn-g btn-full" style="margin-top:16px" @(hasUnsubmitted ? "" : "disabled")>
                        Submit for Admin Verification
                    </button>
                    @if (!userDocs.Any())
                    {
                        <div class="hint" style="text-align:center;margin-top:8px">Upload at least one document to enable submit.</div>
                    }
                    else if (hasPending && !hasUnsubmitted)
                    {
                        <div class="hint" style="text-align:center;margin-top:8px">Already submitted - awaiting admin review. Documents can no longer be changed.</div>
                    }
                    else if (!hasPending && hasRejected)
                    {
                        <div class="hint" style="text-align:center;margin-top:8px">Replace the rejected document(s) first - submit enables once a document is pending review.</div>
                    }
                    else if (!hasPending)
                    {
                        <div class="hint" style="text-align:center;margin-top:8px">All documents are already reviewed. Nothing pending to submit.</div>
                    }
                }
            </div>
        </div>

        <div>
            <div class="card">
                <div class="ct"><span class="ct-dot"></span>Status</div>
                <div class="sr"><span class="srk">Project</span><span class="srv">@req.RequestNumber</span></div>
                <div class="sr"><span class="srk">Applicant</span><span class="srv">@req.ApplicantName</span></div>
                <div class="sr"><span class="srk">Mobile</span><span class="srv">@(string.IsNullOrWhiteSpace(req.MobileNumber) ? "-" : req.MobileNumber)</span></div>
                <div class="sr"><span class="srk">Email</span><span class="srv" style="word-break:break-all">@(string.IsNullOrWhiteSpace(req.Email) ? "-" : req.Email)</span></div>
                <div class="sr"><span class="srk">Current Stage</span><span class="srv"><span class="sts sts-disp">@req.CurrentStage</span></span></div>
                @{
                    var anyDocs = userDocs.Any();
                    string pmLabel; string pmCls;
                    if ((int)req.CurrentStage > (int)SolarPortal.Domain.Enums.ProjectStatus.PMSurvey)
                    {
                        pmLabel = "Verified by Admin"; pmCls = "sts-act";
                    }
                    else if (anyDocs && userDocs.All(x => x.Status == SolarPortal.Domain.Enums.ApprovalStatus.Approved))
                    {
                        pmLabel = "Approved by Admin"; pmCls = "sts-act";
                    }
                    else if (hasRejected)
                    {
                        pmLabel = "Rejected - document replacement needed"; pmCls = "sts-rej";
                    }
                    else if (hasUnsubmitted) { pmLabel = "Not submitted yet"; pmCls = "sts-pend"; }
                    else if (anyDocs) { pmLabel = "Awaiting admin review"; pmCls = "sts-pend"; }
                    else { pmLabel = "Not uploaded yet"; pmCls = "sts-pend"; }
                }
                <div class="sr"><span class="srk">PM Surya Status</span><span class="srv"><span class="sts @pmCls">@pmLabel</span></span></div>
                @if (!string.IsNullOrWhiteSpace(loanOpt))
                {
                    <div class="sr"><span class="srk">Loan Preference</span><span class="srv">@(loanOpt == "Loan" ? "On Loan" : "Without Loan")</span></div>
                }
                <div class="hint" style="margin-top:10px">After admin verifies your documents, you'll be able to download the Site Survey form.</div>
            </div>

            @if (!string.IsNullOrWhiteSpace(pmGharId) || adminDocs.Any())
            {
                <div class="card" style="border-left:4px solid var(--green)">
                    <div class="ct"><span class="ct-dot"></span>Other Documents</div>
                    @if (!string.IsNullOrWhiteSpace(pmGharId))
                    {
                        <div class="sr"><span class="srk">PM Surya Ghar ID</span><span class="srv">@pmGharId</span></div>
                    }
                    @if (adminDocs.Any())
                    {
                        <div class="hint" style="margin:10px 0 6px">Issued by admin - click to view / download:</div>
                        @foreach (var ad in adminDocs)
                        {
                            <a href="javascript:void(0)" onclick="openAdminDoc('@ad.FilePath', @ad.Id)" class="pm-dl">@(string.IsNullOrWhiteSpace(ad.FileName) ? "Approval Document" : ad.FileName)</a>
                            @if (!string.IsNullOrWhiteSpace(ad.Remarks))
                            {
                                <div class="hint" style="margin:2px 0 4px">@ad.Remarks</div>
                            }
                        }
                    }
                    else
                    {
                        <div class="hint" style="margin-top:8px">Admin will upload your approval documents here once your application is approved.</div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@section Styles {
    <style>
        .loan-seg { display:flex; gap:10px; flex-wrap:wrap; }
        .pm-doc { display:flex; align-items:center; gap:12px; padding:12px 14px; margin-top:10px; border:1px solid var(--border); border-radius:var(--r-md); background:var(--bg3); transition:all .15s ease; }
        .pm-doc:hover { border-color:var(--border2); box-shadow:var(--shadow); }
        .pm-doc.done { background:linear-gradient(180deg,#f0fdf4,#fff); border-color:#bbf7d0; }
        .pm-doc-ic { width:42px; height:42px; flex-shrink:0; display:flex; align-items:center; justify-content:center; font-size:22px; border-radius:10px; background:#fff; border:1px solid var(--border); }
        .pm-doc-body { flex:1; min-width:0; }
        .pm-doc-name { font-weight:600; font-size:13.5px; color:var(--text1); line-height:1.3; }
        .pm-doc-sub  { font-size:11.5px; color:var(--text3); margin-top:2px; }
        .pm-doc.done .pm-doc-sub { color:var(--green); }
        .pm-doc-act { display:flex; gap:6px; flex-shrink:0; }
        .pm-doc-remark { font-size:11.5px; color:#b45309; margin-top:3px; font-weight:500; }
        .pm-dl { display:block; padding:8px 12px; margin-top:6px; background:var(--bg3); border:1px solid var(--border); border-radius:var(--r-sm); color:var(--accent-dark); text-decoration:none; font-size:13px; font-weight:500; transition:all .15s ease; word-break:break-all; }
        .pm-dl:hover { background:var(--accent-light); border-color:var(--accent); }
        @@media (max-width:900px) { .g2 { grid-template-columns:1fr !important; } .pm-doc-act { flex-direction:column; } }
        .cap-overlay { position:fixed; inset:0; background:rgba(15,23,42,.6); z-index:2000; display:flex; align-items:center; justify-content:center; padding:16px; }
        .cap-box { background:#fff; border-radius:14px; padding:18px; width:100%; max-width:520px; box-shadow:0 20px 50px rgba(0,0,0,.3); }
        .cap-title { font-weight:700; font-size:16px; margin-bottom:12px; }
        .cap-media { width:100%; max-height:60vh; border-radius:10px; background:#000; display:block; }
        .sig-canvas { width:100%; height:200px; border:2px dashed #cbd5e1; border-radius:10px; background:#fff; touch-action:none; cursor:crosshair; }
        .cap-actions { display:flex; gap:8px; flex-wrap:wrap; justify-content:flex-end; margin-top:14px; }
    </style>
}

@section Scripts {
<script>
$(function () {
    const token = $('input[name="__RequestVerificationToken"]').val();

    // "Other Documents" (admin uploads): everything previews in the modal (images inline,
    // PDFs in an iframe); the modal shows a Download button that streams via DownloadAdminDoc.
    window.openAdminDoc = function (path, id) {
        openFileModal(path, '@Url.Action("DownloadAdminDoc", "PMSurya")' + '?id=' + id);
    };

    $('.pm-pick').on('click', function () {
        $('#' + $(this).data('target')).trigger('click');
    });

    $('.pm-file').on('change', function () {
        const file = this.files[0];
        const docType = $(this).data('type');
        if (!file) return;
        const fd = new FormData();
        fd.append('requestId', @req.Id);
        fd.append('documentType', docType);
        fd.append('file', file);
        fd.append('__RequestVerificationToken', token);
        $.ajax({
            url: '@Url.Action("UploadDocument", "PMSurya")',
            type: 'POST', data: fd, processData: false, contentType: false,
            success: function (r) { if (r.success) { setTimeout(() => location.reload(), 900); } }
        });
    });

    $('.loan-opt').on('click', function () {
        const btn = this;
        if (!window.solarSubmitGuard(btn)) return;

        const opt = $(this).data('opt');
        const $btns = $('.loan-opt');
        const fd = new FormData();
        fd.append('requestId', @req.Id);
        fd.append('loanOption', opt);
        fd.append('__RequestVerificationToken', token);
        $.ajax({
            url: '@Url.Action("SaveLoanOption", "PMSurya")',
            type: 'POST', data: fd, processData: false, contentType: false,
            complete: function () { window.solarSubmitGuard.release(btn); },
            success: function (r) {
                if (r.success) {
                    $btns.removeClass('btn-success').addClass('btn-outline-success');
                    $('.loan-opt[data-opt="' + opt + '"]').removeClass('btn-outline-success').addClass('btn-success');
                    $('#loanSavedMsg').text('Saved');
                    setTimeout(() => $('#loanSavedMsg').text(''), 2000);
                }
            }
        });
    });

    // Posts with $.ajax, so the site-wide form guard never sees it - borrow its
    // lock so a double-click cannot submit the same request twice. On success we
    // stay locked because the page is navigating away.
    $('#btnSubmit').on('click', function () {
        const btn = this;
        if (!window.solarSubmitGuard(btn)) return;

        const fd = new FormData();
        fd.append('requestId', @req.Id);
        fd.append('__RequestVerificationToken', token);
        $.ajax({
            url: '@Url.Action("Submit", "PMSurya")',
            type: 'POST', data: fd, processData: false, contentType: false,
            success: function (r) {
                if (r.success) { setTimeout(() => { window.location.href = '@Url.Action("Status", "SolarRequest", new { id = req.Id })'; }, 900); }
                else { toastMsg('error', r.message || 'Submit failed.'); window.solarSubmitGuard.release(btn); }
            },
            error: function () { toastMsg('error', 'Server error. Please try again.'); window.solarSubmitGuard.release(btn); }
        });
    });
});
</script>
<script>
(function(){
  function on(id,ev,fn){ var e=document.getElementById(id); if(e) e.addEventListener(ev,fn); }
  function antiToken(){ var e=document.querySelector('input[name="__RequestVerificationToken"]'); return e ? e.value : ''; }
  function uploadCaptured(blob, docType, filename){
    var fd = new FormData();
    fd.append('requestId', @req.Id);
    fd.append('documentType', docType);
    fd.append('file', blob, filename);
    fd.append('__RequestVerificationToken', antiToken());
    $.ajax({ url:'@Url.Action("UploadDocument","PMSurya")', type:'POST', data:fd, processData:false, contentType:false,
      success:function(r){ if(r.success){ setTimeout(function(){ location.reload(); }, 700); } } });
  }

  // ---- Live photo (camera) ----
  var lpStream=null;
  function lpButtons(mode){
    var cap=document.getElementById('lpCapture'), re=document.getElementById('lpRetake'), sv=document.getElementById('lpSave');
    if(cap) cap.style.display = mode==='live'?'':'none';
    if(re)  re.style.display  = mode==='shot'?'':'none';
    if(sv)  sv.style.display  = mode==='shot'?'':'none';
  }
  window.openLivePhoto=function(){
    var modal=document.getElementById('livePhotoModal'); if(!modal) return; modal.style.display='flex';
    var video=document.getElementById('lpVideo');
    if(!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia){ toastMsg('warning', 'Camera is not supported in this browser.'); closeLivePhoto(); return; }
    navigator.mediaDevices.getUserMedia({ video:{ facingMode:'user' }, audio:false })
      .then(function(s){ lpStream=s; video.srcObject=s; video.style.display=''; document.getElementById('lpCanvas').style.display='none'; lpButtons('live'); })
      .catch(function(e){ toastMsg('error', 'Camera access denied: ' + e.message); closeLivePhoto(); });
  };
  window.closeLivePhoto=function(){ var m=document.getElementById('livePhotoModal'); if(m) m.style.display='none'; if(lpStream){ lpStream.getTracks().forEach(function(t){t.stop();}); lpStream=null; } };
  on('lpCapture','click', function(){ var v=document.getElementById('lpVideo'), c=document.getElementById('lpCanvas'); c.width=v.videoWidth||640; c.height=v.videoHeight||480; c.getContext('2d').drawImage(v,0,0,c.width,c.height); v.style.display='none'; c.style.display=''; lpButtons('shot'); });
  on('lpRetake','click', function(){ document.getElementById('lpVideo').style.display=''; document.getElementById('lpCanvas').style.display='none'; lpButtons('live'); });
  on('lpSave','click', function(){ document.getElementById('lpCanvas').toBlob(function(b){ uploadCaptured(b,'Photo','applicant-photo.png'); closeLivePhoto(); }, 'image/png'); });

  // ---- Signature pad ----
  var sigCtx=null, drawing=false, hasInk=false, last=null;
  function sigPos(e){ var c=document.getElementById('sigCanvas'), r=c.getBoundingClientRect(); var p=(e.touches&&e.touches[0])||e; return { x:p.clientX-r.left, y:p.clientY-r.top }; }
  window.openSignaturePad=function(){
    var modal=document.getElementById('signModal'); if(!modal) return; modal.style.display='flex';
    var c=document.getElementById('sigCanvas'); c.width=c.offsetWidth; c.height=c.offsetHeight;
    sigCtx=c.getContext('2d'); sigCtx.fillStyle='#fff'; sigCtx.fillRect(0,0,c.width,c.height);
    sigCtx.strokeStyle='#111827'; sigCtx.lineWidth=2.2; sigCtx.lineJoin='round'; sigCtx.lineCap='round'; hasInk=false;
  };
  window.closeSignature=function(){ var m=document.getElementById('signModal'); if(m) m.style.display='none'; };
  (function(){ var c=document.getElementById('sigCanvas'); if(!c) return;
    c.addEventListener('pointerdown', function(e){ e.preventDefault(); drawing=true; last=sigPos(e); });
    c.addEventListener('pointermove', function(e){ if(!drawing) return; e.preventDefault(); var p=sigPos(e); sigCtx.beginPath(); sigCtx.moveTo(last.x,last.y); sigCtx.lineTo(p.x,p.y); sigCtx.stroke(); last=p; hasInk=true; });
    window.addEventListener('pointerup', function(){ drawing=false; });
  })();
  on('sigClear','click', function(){ var c=document.getElementById('sigCanvas'); if(sigCtx){ sigCtx.fillStyle='#fff'; sigCtx.fillRect(0,0,c.width,c.height); hasInk=false; } });
  on('sigSave','click', function(){ if(!hasInk){ toastMsg('warning', 'Please draw your signature first.'); return; } document.getElementById('sigCanvas').toBlob(function(b){ uploadCaptured(b,'Signature','signature.png'); closeSignature(); }, 'image/png'); });
})();
</script>
@Html.AntiForgeryToken()
}

@* Live-photo (camera) + signature-pad modals *@
<div id="livePhotoModal" class="cap-overlay" style="display:none">
  <div class="cap-box">
    <div class="cap-title">Take Live Photo</div>
    <video id="lpVideo" autoplay playsinline class="cap-media"></video>
    <canvas id="lpCanvas" class="cap-media" style="display:none"></canvas>
    <div class="cap-actions">
      <button type="button" class="btn btn-p" id="lpCapture">Capture</button>
      <button type="button" class="btn btn-s" id="lpRetake" style="display:none">Retake</button>
      <button type="button" class="btn btn-g" id="lpSave" style="display:none">Save &amp; Upload</button>
      <button type="button" class="btn btn-s" onclick="closeLivePhoto()">Cancel</button>
    </div>
  </div>
</div>

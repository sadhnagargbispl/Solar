@{
    ViewData["Title"] = "My Reports";
    var f          = (ViewBag.Filter as string) ?? "all";
    var requests   = ViewBag.Requests    as List<SolarPortal.Domain.Entities.SolarRequest> ?? new();
    var payments   = ViewBag.Payments    as List<SolarPortal.Domain.Entities.Payment>       ?? new();
    var pmDocs     = ViewBag.PMDocs      as List<SolarPortal.Domain.Entities.PMDocument>    ?? new();
    var surveys    = ViewBag.SiteSurveys as List<SolarPortal.Domain.Entities.SiteSurvey>    ?? new();
    var meters     = ViewBag.Meters      as List<SolarPortal.Domain.Entities.MeterDispatch>    ?? new();
    var materials  = ViewBag.Materials   as List<SolarPortal.Domain.Entities.MaterialDispatch> ?? new();
    var installs   = ViewBag.Installations as List<SolarPortal.Domain.Entities.Installation>  ?? new();
    var dcrDocs    = ViewBag.DcrDocs     as List<SolarPortal.Domain.Entities.DCRDocument>   ?? new();
    var reqLookup  = ViewBag.RequestLookup as Dictionary<int, string> ?? new();

    string ReqNum(int id) => reqLookup.TryGetValue(id, out var n) ? n : $"#{id}";

    string Cls(string name) => f == name ? "btn btn-p" : "btn btn-outline";

    var fileExists = ViewBag.FileExists as Dictionary<string, bool> ?? new();
    var paidByReq  = ViewBag.PaidByRequest as Dictionary<int, decimal> ?? new();
    decimal PaidOf(int id) => paidByReq.TryGetValue(id, out var _pv) ? _pv : 0m;

    // Resolved URL per stored path (controller-built): local wwwroot when present,
    // otherwise the admin server (admin-panel uploads live there).
    var fileUrls = ViewBag.FileUrl as Dictionary<string, string> ?? new();
    string? FileUrlOf(string? p) => !string.IsNullOrWhiteSpace(p) && fileUrls.TryGetValue(p!, out var u) ? u : null;

    // DocumentType values 11-14 belong to the ADMIN project (no enum member here).
    string DocTypeLabel(SolarPortal.Domain.Enums.DocumentType t) =>
        (int)t >= 11 && (int)t <= 14 ? "Admin Approval Document" : t.ToString();

    string Dash(string? v) => string.IsNullOrWhiteSpace(v) ? "—" : v;

    // Status pill helpers used across all sections
    string PaymentBadge(SolarPortal.Domain.Enums.PaymentStatus s) => s switch
    {
        SolarPortal.Domain.Enums.PaymentStatus.Completed => "<span class='sts sts-act'>✅ Verified</span>",
        SolarPortal.Domain.Enums.PaymentStatus.Rejected => "<span class='sts sts-rej'>❌ Rejected</span>",
        _                                               => "<span class='sts sts-pen'>⏳ Pending</span>"
    };
    string ApprovalBadge(SolarPortal.Domain.Enums.ApprovalStatus s) => s switch
    {
        SolarPortal.Domain.Enums.ApprovalStatus.Approved => "<span class='sts sts-act'>✅ Approved</span>",
        SolarPortal.Domain.Enums.ApprovalStatus.Rejected => "<span class='sts sts-rej'>❌ Rejected</span>",
        _                                                => "<span class='sts sts-pen'>⏳ Pending</span>"
    };
}

<style>
    /* ── My Reports professional polish ─────────────────────────────── */
    .rpt-card { background:#fff; border:1px solid #e5e7eb; border-radius:10px; margin-bottom:16px; overflow:hidden; box-shadow:0 1px 2px rgba(0,0,0,.04); }
    .rpt-head { display:flex; align-items:center; gap:10px; padding:13px 16px; border-bottom:1px solid #e5e7eb; background:linear-gradient(180deg,#f8fafc,#f1f5f9); }
    .rpt-head .ttl { font-weight:700; font-size:14px; color:#0f172a; }
    .rpt-head .cnt { background:#16a34a; color:#fff; font-size:11.5px; font-weight:700; border-radius:999px; padding:2px 9px; }
    .rpt-card table { width:100%; border-collapse:collapse; }
    .rpt-card thead th { font-size:11px; letter-spacing:.4px; text-transform:uppercase; color:#64748b; text-align:left; padding:9px 12px; background:#fafafa; border-bottom:1px solid #e5e7eb; white-space:nowrap; }
    .rpt-card tbody td { padding:10px 12px; font-size:13px; color:#1e293b; border-bottom:1px solid #f1f5f9; vertical-align:middle; }
    .rpt-card tbody tr:hover:not(.det-tr) { background:#f8fafc; }
    .btn-det { border:1px solid #16a34a; color:#16a34a; background:#fff; border-radius:6px; padding:3px 10px; font-size:12px; font-weight:600; cursor:pointer; white-space:nowrap; }
    .btn-det:hover { background:#16a34a; color:#fff; }
    .det-tr > td { background:#f8fafc !important; padding:0 !important; }
    .det-box { padding:16px 18px; }
    .det-sec { margin-bottom:14px; }
    .det-sec:last-child { margin-bottom:0; }
    .det-sec-ttl { font-size:12px; font-weight:700; color:#166534; text-transform:uppercase; letter-spacing:.5px; margin-bottom:8px; border-bottom:1px dashed #cbd5e1; padding-bottom:4px; }
    .kv-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:10px 22px; }
    .kv .k { font-size:11px; color:#64748b; margin-bottom:2px; }
    .kv .v { font-size:13px; font-weight:600; color:#0f172a; word-break:break-word; }
    .kv .v a { color:#d97706; text-decoration:none; }
    .tbl-wrap { overflow-x:auto; }
    .inner-tbl { background:#fff; border:1px solid #e5e7eb; border-radius:8px; overflow:hidden; }
    .inner-tbl thead th { background:#f1f5f9; }
</style>

<div class="page-header" style="padding:16px">
    <h2>My Reports</h2>
    <p class="text-muted">Your full history across all modules — every stage, every value you filled, every admin action.</p>
</div>

<div class="container-fluid">
    @* Filter tabs (4-state, same as admin) *@
    <div class="mb-3" style="display:flex;gap:8px;flex-wrap:wrap">
        <a class="@Cls("all")"      asp-action="Index" asp-route-filter="all">📋 All</a>
        <a class="@Cls("pending")"  asp-action="Index" asp-route-filter="pending">⏳ Pending</a>
        <a class="@Cls("approved")" asp-action="Index" asp-route-filter="approved">✅ Approved</a>
        <a class="@Cls("rejected")" asp-action="Index" asp-route-filter="rejected">❌ Rejected</a>
    </div>

    @if (!requests.Any())
    {
        <div class="card">
            <div class="card-body text-center text-muted" style="padding:32px">
                You don't have any solar requests yet.
                <br />
                <a class="btn btn-success mt-3"
                   asp-area="SolarPanelUserPanel" asp-controller="SolarRequest" asp-action="Create">
                    ➕ Start a New Request
                </a>
            </div>
        </div>
    }
    else
    {
        @* ─── 1. Solar Requests (every request incl. with/without activation) ── *@
        <div class="rpt-card">
            <div class="rpt-head"><span>🗂️</span><span class="ttl">Solar Requests</span><span class="cnt">@requests.Count</span></div>
            <div class="tbl-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Request #</th>
                            <th>Request Type</th>
                            <th>Package</th>
                            <th>Capacity</th>
                            <th>Project Amount</th>
                            <th>Paid</th>
                            <th>Due</th>
                            <th>Stage</th>
                            <th>Approval</th>
                            <th>Submitted</th>
                            <th>Full Details</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in requests)
                        {
                            // Per spec: a Completed project is implicitly Approved
                            // regardless of any stale ApprovalStatus on the record.
                            var effectiveApproval = r.CurrentStage == SolarPortal.Domain.Enums.ProjectStatus.Completed
                                ? SolarPortal.Domain.Enums.ApprovalStatus.Approved
                                : r.ApprovalStatus;

                            var reqTypeLabel = r.RequestType switch
                            {
                                SolarPortal.Domain.Enums.RequestType.WithActivation              => "🔌 With Activation",
                                SolarPortal.Domain.Enums.RequestType.OnlySolarWithoutActivation  => "⚡ Without Activation",
                                SolarPortal.Domain.Enums.RequestType.AlreadyActiveOnlyRequest    => "✅ Already Active",
                                _ => r.RequestType.ToString()
                            };
                            var pmGharId = !string.IsNullOrWhiteSpace(r.PMSuryaGharIdNo) ? r.PMSuryaGharIdNo : r.PmSuryaApplicationNo;
                            var due = (r.PlanAmount - PaidOf(r.Id)) > 0m ? (r.PlanAmount - PaidOf(r.Id)) : 0m;
                            var lightBillProofUrl = FileUrlOf(r.LightBillProofPath);

                            <tr>
                                <td class="td-b">
                                    <a asp-action="Status" asp-controller="SolarRequest"
                                       asp-area="SolarPanelUserPanel" asp-route-id="@r.Id"
                                       style="color:var(--green);font-weight:700">@r.RequestNumber</a>
                                </td>
                                <td style="font-size:12.5px;white-space:nowrap">@reqTypeLabel</td>
                                <td style="font-size:12.5px;max-width:160px" title="@r.SelectedPlan">@Dash(r.SelectedPlan)</td>
                                <td>@r.KVCapacity kV</td>
                                <td>₹@r.PlanAmount.ToString("N0")</td>
                                <td style="color:#16a34a;font-weight:600">₹@PaidOf(r.Id).ToString("N0")</td>
                                <td style="color:@(due > 0 ? "#dc2626" : "#16a34a");font-weight:600">₹@due.ToString("N0")</td>
                                <td><span class="sts sts-disp">@r.CurrentStage.ToString().Replace("_", " ")</span></td>
                                <td>@Html.Raw(ApprovalBadge(effectiveApproval))</td>
                                <td style="white-space:nowrap">@r.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                                <td><button type="button" class="btn-det" onclick="toggleDet('rq-@r.Id', this)">▸ Details</button></td>
                            </tr>
                            <tr id="rq-@r.Id" class="det-tr" style="display:none">
                                <td colspan="11">
                                    <div class="det-box">
                                        <div class="det-sec">
                                            <div class="det-sec-ttl">👤 Applicant</div>
                                            <div class="kv-grid">
                                                <div class="kv"><div class="k">Name</div><div class="v">@Dash(r.ApplicantName)</div></div>
                                                <div class="kv"><div class="k">Mobile</div><div class="v">@Dash(r.MobileNumber)</div></div>
                                                <div class="kv"><div class="k">Alternate Mobile</div><div class="v">@Dash(r.AlternateMobile)</div></div>
                                                <div class="kv"><div class="k">Email</div><div class="v">@Dash(r.Email)</div></div>
                                                <div class="kv"><div class="k">Address</div><div class="v">@Dash(r.Address)</div></div>
                                                <div class="kv"><div class="k">City / State / PIN</div><div class="v">@Dash(r.City) / @Dash(r.State) / @Dash(r.PinCode)</div></div>
                                                <div class="kv"><div class="k">Aadhaar</div><div class="v">@Dash(r.AadharNumber)</div></div>
                                                <div class="kv"><div class="k">PAN</div><div class="v">@Dash(r.PANNumber)</div></div>
                                            </div>
                                        </div>
                                        <div class="det-sec">
                                            <div class="det-sec-ttl">📦 Plan &amp; Product</div>
                                            <div class="kv-grid">
                                                <div class="kv"><div class="k">Request Type</div><div class="v">@reqTypeLabel</div></div>
                                                <div class="kv"><div class="k">Package</div><div class="v">@Dash(r.SelectedPlan)</div></div>
                                                <div class="kv"><div class="k">Capacity</div><div class="v">@r.KVCapacity kV</div></div>
                                                <div class="kv"><div class="k">Connection Type</div><div class="v">@r.ConnectionType</div></div>
                                                <div class="kv"><div class="k">Project Amount</div><div class="v">₹@r.PlanAmount.ToString("N0")</div></div>
                                                <div class="kv"><div class="k">Paid (Verified)</div><div class="v" style="color:#16a34a">₹@PaidOf(r.Id).ToString("N0")</div></div>
                                                <div class="kv"><div class="k">Due</div><div class="v" style="color:@(due > 0 ? "#dc2626" : "#16a34a")">₹@due.ToString("N0")</div></div>
                                            </div>
                                        </div>
                                        <div class="det-sec">
                                            <div class="det-sec-ttl">💡 Light Bill</div>
                                            <div class="kv-grid">
                                                <div class="kv"><div class="k">Ownership</div><div class="v">@(r.LightBillOwnership == "BloodRelation" ? "Blood relation" : (r.LightBillOwnership == "Self" ? "Self" : "—"))</div></div>
                                                <div class="kv"><div class="k">Relation Holder Name</div><div class="v">@Dash(r.LightBillRelationName)</div></div>
                                                <div class="kv"><div class="k">Relation Proof</div><div class="v">@if (lightBillProofUrl != null) { <a href="javascript:void(0)" onclick="openFileModal('@lightBillProofUrl')">📄 View</a> } else { <text>—</text> }</div></div>
                                            </div>
                                        </div>
                                        <div class="det-sec">
                                            <div class="det-sec-ttl">🌞 PM Surya Ghar &amp; Workflow</div>
                                            <div class="kv-grid">
                                                <div class="kv"><div class="k">Loan Preference</div><div class="v">@(string.IsNullOrWhiteSpace(r.PMSuryaLoanOption) ? "—" : (r.PMSuryaLoanOption == "Loan" ? "On Loan" : "Without Loan"))</div></div>
                                                <div class="kv"><div class="k">PM Surya Ghar ID</div><div class="v">@Dash(pmGharId)</div></div>
                                                <div class="kv"><div class="k">Current Stage</div><div class="v">@r.CurrentStage</div></div>
                                                <div class="kv"><div class="k">Approval</div><div class="v">@Html.Raw(ApprovalBadge(effectiveApproval))</div></div>
                                                <div class="kv"><div class="k">Rejection Reason</div><div class="v">@Dash(r.RejectionReason)</div></div>
                                                <div class="kv"><div class="k">Submitted On</div><div class="v">@r.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</div></div>
                                                <div class="kv"><div class="k">Last Updated</div><div class="v">@(r.UpdatedAt?.ToLocalTime().ToString("dd MMM yyyy HH:mm") ?? "—")</div></div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @* ─── 2. Payments ────────────────────────────────────────────── *@
        @if (payments.Any())
        {
            <div class="rpt-card">
                <div class="rpt-head"><span>💳</span><span class="ttl">Payments</span><span class="cnt">@payments.Count</span></div>
                <div class="tbl-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>Request #</th>
                                <th>Amount</th>
                                <th>UTR / Txn</th>
                                <th>Method</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th>Approved / Rejected On</th>
                                <th>Remark</th>
                                <th>Receipt</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in payments)
                            {
                                string? receiptUrl = FileUrlOf(p.ReceiptImagePath);
                                <tr>
                                    <td>@ReqNum(p.SolarRequestId)</td>
                                    <td>₹@p.Amount.ToString("N0")</td>
                                    <td><code style="font-size:11px">@(p.UTRNumber ?? "—")</code></td>
                                    <td>@(p.PaymentMethod ?? "—")</td>
                                    <td>@p.PaymentDate.ToLocalTime().ToString("dd MMM yyyy")</td>
                                    <td>@Html.Raw(PaymentBadge(p.Status))</td>
                                    <td>@((p.VerifiedAt ?? p.UpdatedAt)?.ToLocalTime().ToString("dd MMM yyyy") ?? "—")</td>
                                    <td>@Dash(p.Notes)</td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(receiptUrl))
                                        {
                                            <a href="javascript:void(0)" onclick="openFileModal('@receiptUrl')" style="color:var(--sun)">📷 View</a>
                                        }
                                        else { <span class="text-muted">—</span> }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @* ─── 3. PM Surya Ghar Documents — one summary row per request ── *@
        @if (pmDocs.Any())
        {
            <div class="rpt-card">
                <div class="rpt-head"><span>🌞</span><span class="ttl">PM Surya Ghar Documents</span><span class="cnt">@pmDocs.Count</span></div>
                <div class="tbl-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>Request #</th>
                                <th>Total Documents</th>
                                <th>Approved</th>
                                <th>Pending</th>
                                <th>Rejected</th>
                                <th>Last Updated</th>
                                <th>Full Details</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var grp in pmDocs.GroupBy(x => x.SolarRequestId))
                            {
                                var aprCnt = grp.Count(x => x.Status == SolarPortal.Domain.Enums.ApprovalStatus.Approved);
                                var penCnt = grp.Count(x => x.Status == SolarPortal.Domain.Enums.ApprovalStatus.Pending);
                                var rejCnt = grp.Count(x => x.Status == SolarPortal.Domain.Enums.ApprovalStatus.Rejected);
                                var lastUpd = grp.Max(x => x.UpdatedAt ?? x.CreatedAt);
                                <tr>
                                    <td class="td-b" style="font-weight:700">@ReqNum(grp.Key)</td>
                                    <td>@grp.Count()</td>
                                    <td><span class="sts sts-act">✅ @aprCnt</span></td>
                                    <td>@(penCnt > 0 ? Html.Raw($"<span class='sts sts-pen'>⏳ {penCnt}</span>") : Html.Raw("<span class='text-muted'>0</span>"))</td>
                                    <td>@(rejCnt > 0 ? Html.Raw($"<span class='sts sts-rej'>❌ {rejCnt}</span>") : Html.Raw("<span class='text-muted'>0</span>"))</td>
                                    <td style="white-space:nowrap">@lastUpd.ToLocalTime().ToString("dd MMM yyyy")</td>
                                    <td><button type="button" class="btn-det" onclick="toggleDet('pm-@grp.Key', this)">▸ Details</button></td>
                                </tr>
                                <tr id="pm-@grp.Key" class="det-tr" style="display:none">
                                    <td colspan="7">
                                        <div class="det-box">
                                            <table class="inner-tbl">
                                                <thead>
                                                    <tr>
                                                        <th>Document Type</th>
                                                        <th>Uploaded</th>
                                                        <th>Status</th>
                                                        <th>Approved / Rejected On</th>
                                                        <th>Remark</th>
                                                        <th>File</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var d in grp)
                                                    {
                                                        string? pmDocUrl = FileUrlOf(d.FilePath);
                                                        <tr>
                                                            <td>@DocTypeLabel(d.DocumentType)</td>
                                                            <td>@d.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                                                            <td>@Html.Raw(ApprovalBadge(d.Status))</td>
                                                            <td>@(d.Status != SolarPortal.Domain.Enums.ApprovalStatus.Pending ? (d.UpdatedAt?.ToLocalTime().ToString("dd MMM yyyy") ?? "—") : "—")</td>
                                                            <td>
                                                                @if (!string.IsNullOrWhiteSpace(d.Remarks))
                                                                {
                                                                    <span style="color:#dc3545;font-size:12px">@d.Remarks</span>
                                                                }
                                                                else { <span class="text-muted">—</span> }
                                                            </td>
                                                            <td>
                                                                @if (!string.IsNullOrWhiteSpace(pmDocUrl))
                                                                {
                                                                    <a href="javascript:void(0)" onclick="openFileModal('@pmDocUrl')" style="color:var(--sun)">📄 View</a>
                                                                }
                                                                else { <span class="text-muted">—</span> }
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @* ─── 4. Site Surveys — full detail of everything filled ──────── *@
        @if (surveys.Any())
        {
            <div class="rpt-card">
                <div class="rpt-head"><span>📐</span><span class="ttl">Site Surveys</span><span class="cnt">@surveys.Count</span></div>
                <div class="tbl-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>Request #</th>
                                <th>Property Type</th>
                                <th>DISCOM</th>
                                <th>Survey Date</th>
                                <th>Status</th>
                                <th>Approved / Rejected On</th>
                                <th>Remark</th>
                                <th>Full Details</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in surveys)
                            {
                                var ss = s.IsCompleted
                                    ? SolarPortal.Domain.Enums.ApprovalStatus.Approved
                                    : s.ApprovalStatus;
                                var roofUrl  = FileUrlOf(s.RoofPhotoPath);
                                var houseUrl = FileUrlOf(s.GpsPhotoPath);
                                var roofTypeTxt = s.RoofType == "Other" && !string.IsNullOrWhiteSpace(s.RoofTypeOther)
                                    ? $"Other ({s.RoofTypeOther})" : Dash(s.RoofType);
                                var dirTxt = s.RoofDirection == "Other" && !string.IsNullOrWhiteSpace(s.RoofDirectionOther)
                                    ? $"Other ({s.RoofDirectionOther})" : Dash(s.RoofDirection);
                                <tr>
                                    <td>@ReqNum(s.SolarRequestId)</td>
                                    <td>@Dash(s.PropertyType)</td>
                                    <td>@Dash(s.DiscomName)</td>
                                    <td>@(s.SurveyDate?.ToLocalTime().ToString("dd MMM yyyy") ?? "—")</td>
                                    <td>@Html.Raw(ApprovalBadge(ss))</td>
                                    <td>@(s.IsCompleted ? (s.CompletedAt?.ToLocalTime().ToString("dd MMM yyyy") ?? "—") : (s.ApprovalStatus == SolarPortal.Domain.Enums.ApprovalStatus.Rejected ? (s.RejectedAt?.ToLocalTime().ToString("dd MMM yyyy") ?? "—") : "—"))</td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(s.RejectionReason))
                                        {
                                            <span style="color:#dc3545;font-size:12px">@s.RejectionReason</span>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(s.OperationsRemark))
                                        {
                                            <span style="color:#dc3545;font-size:12px">@s.OperationsRemark</span>
                                        }
                                        else { <span class="text-muted">—</span> }
                                    </td>
                                    <td><button type="button" class="btn-det" onclick="toggleDet('ss-@s.Id', this)">▸ Details</button></td>
                                </tr>
                                <tr id="ss-@s.Id" class="det-tr" style="display:none">
                                    <td colspan="8">
                                        <div class="det-box">
                                            <div class="det-sec">
                                                <div class="det-sec-ttl">🏠 General Information</div>
                                                <div class="kv-grid">
                                                    <div class="kv"><div class="k">Connection Type</div><div class="v">@Dash(s.PropertyType)</div></div>
                                                    <div class="kv"><div class="k">Roof Available</div><div class="v">@Dash(s.RoofAvailable)</div></div>
                                                    <div class="kv"><div class="k">Roof Type</div><div class="v">@roofTypeTxt</div></div>
                                                    <div class="kv"><div class="k">Roof Total Area</div><div class="v">@(s.RoofTotalAreaSqft?.ToString("N2") ?? "—") sq ft</div></div>
                                                </div>
                                            </div>
                                            <div class="det-sec">
                                                <div class="det-sec-ttl">⚡ Electrical / Connection</div>
                                                <div class="kv-grid">
                                                    <div class="kv"><div class="k">DISCOM</div><div class="v">@Dash(s.DiscomName)</div></div>
                                                    <div class="kv"><div class="k">Meter Type</div><div class="v">@Dash(s.MeterType)</div></div>
                                                    <div class="kv"><div class="k">Grid Connection Type</div><div class="v">@Dash(s.GridType)</div></div>
                                                </div>
                                            </div>
                                            <div class="det-sec">
                                                <div class="det-sec-ttl">🌤️ Site Conditions</div>
                                                <div class="kv-grid">
                                                    <div class="kv"><div class="k">Shadow on Roof</div><div class="v">@Dash(s.ShadowOnRoof)</div></div>
                                                    <div class="kv"><div class="k">Obstructions</div><div class="v">@(string.IsNullOrWhiteSpace(s.Obstructions) ? "—" : s.Obstructions.Replace(",", ", "))</div></div>
                                                    <div class="kv"><div class="k">Roof Direction</div><div class="v">@dirTxt</div></div>
                                                    <div class="kv"><div class="k">Earthing Available</div><div class="v">@Dash(s.EarthingAvailable)</div></div>
                                                    <div class="kv"><div class="k">Internet Available</div><div class="v">@Dash(s.InternetAvailable)</div></div>
                                                </div>
                                            </div>
                                            <div class="det-sec">
                                                <div class="det-sec-ttl">📷 Photos &amp; Notes</div>
                                                <div class="kv-grid">
                                                    <div class="kv"><div class="k">Roof Photo</div><div class="v">@if (roofUrl != null) { <a href="javascript:void(0)" onclick="openFileModal('@roofUrl')">📷 View</a> } else { <text>—</text> }</div></div>
                                                    <div class="kv"><div class="k">House Photo</div><div class="v">@if (houseUrl != null) { <a href="javascript:void(0)" onclick="openFileModal('@houseUrl')">📷 View</a> } else { <text>—</text> }</div></div>
                                                    <div class="kv"><div class="k">Survey Notes</div><div class="v">@Dash(s.SurveyNotes)</div></div>
                                                    <div class="kv"><div class="k">Submitted On</div><div class="v">@s.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</div></div>
                                                    <div class="kv"><div class="k">Status</div><div class="v">@Html.Raw(ApprovalBadge(ss))</div></div>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @* ─── 5. Meter Dispatch (read-only — admin action) ────────────── *@
        @if (meters.Any() && (f == "all" || f == "approved"))
        {
            <div class="rpt-card">
                <div class="rpt-head"><span>⚡</span><span class="ttl">Meter Dispatch</span><span class="cnt">@meters.Count</span></div>
                <div class="tbl-wrap">
                    <table>
                        <thead>
                            <tr><th>Request #</th><th>Meter #</th><th>Type</th><th>Date</th><th>Remark</th><th>Document</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var m in meters)
                            {
                                string? mDispUrl = FileUrlOf(m.DispatchDocumentPath);
                                <tr>
                                    <td>@ReqNum(m.SolarRequestId)</td>
                                    <td>@Dash(m.MeterNumber)</td>
                                    <td>@Dash(m.MeterType)</td>
                                    <td>@(m.DispatchDate?.ToLocalTime().ToString("dd MMM yyyy") ?? "—")</td>
                                    <td>@Dash(m.Remark)</td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(mDispUrl))
                                        {
                                            <a href="javascript:void(0)" onclick="openFileModal('@mDispUrl')" style="color:var(--sun)">📄 View</a>
                                        }
                                        else { <span class="text-muted">—</span> }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @* ─── 6. Material Dispatch ────────────────────────────────────── *@
        @if (materials.Any() && (f == "all" || f == "approved"))
        {
            <div class="rpt-card">
                <div class="rpt-head"><span>🚚</span><span class="ttl">Material Dispatch</span><span class="cnt">@materials.Count</span></div>
                <div class="tbl-wrap">
                    <table>
                        <thead>
                            <tr><th>Request #</th><th>Material</th><th>Vehicle</th><th>Date</th><th>Remark</th><th>Document</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var m in materials)
                            {
                                string? mDispUrl = FileUrlOf(m.DispatchDocumentPath);
                                <tr>
                                    <td>@ReqNum(m.SolarRequestId)</td>
                                    <td>@Dash(m.MaterialDetails)</td>
                                    <td>@Dash(m.VehicleDetails)</td>
                                    <td>@(m.DispatchDate?.ToLocalTime().ToString("dd MMM yyyy") ?? "—")</td>
                                    <td>@Dash(m.Remark)</td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(mDispUrl))
                                        {
                                            <a href="javascript:void(0)" onclick="openFileModal('@mDispUrl')" style="color:var(--sun)">📄 View</a>
                                        }
                                        else { <span class="text-muted">—</span> }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @* ─── 7. Installation ─────────────────────────────────────────── *@
        @if (installs.Any() && (f == "all" || f == "approved"))
        {
            <div class="rpt-card">
                <div class="rpt-head"><span>🔧</span><span class="ttl">Installation</span><span class="cnt">@installs.Count</span></div>
                <div class="tbl-wrap">
                    <table>
                        <thead>
                            <tr><th>Request #</th><th>Date</th><th>Notes</th><th>Remark</th><th>Photo</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var i in installs)
                            {
                                string? iPhotoUrl = FileUrlOf(i.CompletionPhotoPath);
                                <tr>
                                    <td>@ReqNum(i.SolarRequestId)</td>
                                    <td>@(i.InstallationDate?.ToLocalTime().ToString("dd MMM yyyy") ?? "—")</td>
                                    <td>@Dash(i.Notes)</td>
                                    <td>@Dash(i.Remark)</td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(iPhotoUrl))
                                        {
                                            <a href="javascript:void(0)" onclick="openFileModal('@iPhotoUrl')" style="color:var(--sun)">📷 View</a>
                                        }
                                        else { <span class="text-muted">—</span> }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @* ─── 8. DCR Documents ────────────────────────────────────────── *@
        @if (dcrDocs.Any())
        {
            <div class="rpt-card">
                <div class="rpt-head"><span>📑</span><span class="ttl">DCR Documents</span><span class="cnt">@dcrDocs.Count</span></div>
                <div class="tbl-wrap">
                    <table>
                        <thead>
                            <tr><th>Request #</th><th>DCR #</th><th>DCR Date</th><th>Status</th><th>Approved / Rejected On</th><th>Remark</th><th>Document</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var d in dcrDocs)
                            {
                                string? dDocUrl = FileUrlOf(d.DocumentPath);
                                <tr>
                                    <td>@ReqNum(d.SolarRequestId)</td>
                                    <td>@Dash(d.DCRNumber)</td>
                                    <td>@(d.DCRDate?.ToLocalTime().ToString("dd MMM yyyy") ?? "—")</td>
                                    <td>@Html.Raw(ApprovalBadge(d.ApprovalStatus))</td>
                                    <td>@(d.ApprovalStatus == SolarPortal.Domain.Enums.ApprovalStatus.Approved ? (d.ApprovedAt?.ToLocalTime().ToString("dd MMM yyyy") ?? "—") : (d.ApprovalStatus == SolarPortal.Domain.Enums.ApprovalStatus.Rejected ? (d.UpdatedAt?.ToLocalTime().ToString("dd MMM yyyy") ?? "—") : "—"))</td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(d.RejectionReason))
                                        {
                                            <span style="color:#dc3545;font-size:12px">@d.RejectionReason</span>
                                        }
                                        else { <span class="text-muted">—</span> }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(dDocUrl))
                                        {
                                            <a href="javascript:void(0)" onclick="openFileModal('@dDocUrl')" style="color:var(--sun)">📄 View</a>
                                        }
                                        else { <span class="text-muted">—</span> }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>

<script>
    // Expand / collapse a "Full Details" row
    function toggleDet(id, btn) {
        var row = document.getElementById(id);
        if (!row) return;
        var open = row.style.display !== 'none';
        row.style.display = open ? 'none' : 'table-row';
        if (btn) btn.innerHTML = open ? '▸ Details' : '▾ Hide';
    }
</script>

@* In-page file preview modal (no new tab) *@
@await Html.PartialAsync("_FileModal")

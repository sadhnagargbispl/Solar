@model SolarPortal.Application.DTOs.SolarRequestDto?
@{
    ViewData["Title"] = "Project Status";
    var subTotal = (decimal)(ViewBag.TotalSubmitted ?? 0m);
    var verTotal = (decimal)(ViewBag.VerifiedPaid ?? 0m);
    var minVal = (decimal)(ViewBag.Minimum ?? 20000m);
    // Point 1: money the member already paid on the cPanel order that activated
    // their ID. It is already inside VerifiedPaid, so it must be NAMED here -
    // otherwise "Paid ₹30,000" against ₹10,100 of visible receipts looks wrong.
    var statusDeposit = (decimal)(ViewBag.ActiveIdDeposit ?? 0m);

    string StageStsClass(SolarPortal.Domain.Enums.ProjectStatus s) => s switch
    {
        SolarPortal.Domain.Enums.ProjectStatus.Completed => "sts-act",
        SolarPortal.Domain.Enums.ProjectStatus.MeterDispatch => "sts-disp",
        SolarPortal.Domain.Enums.ProjectStatus.Installation => "sts-disp",
        _ => "sts-pend"
    };
    // "Unfilled stub" = user registered (account exists) but hasn't picked a
    // plan/product or entered any amount yet. The timeline still shows
    // (Registration done, rest pending) but plan/capacity/amount rows are hidden
    // until they actually select a plan — per spec: "registration ho gaya hai,
    // baaki details abhi nahi dikhni chahiye."
    var isUnfilledStub = Model != null
        && !Model.SolarProjectId.HasValue
        && !Model.ExternalProductId.HasValue
        && Model.KVCapacity == 0m
        && Model.PlanAmount == 0m
        && Model.RequestedAmount == 0m
        && Model.CurrentStage != SolarPortal.Domain.Enums.ProjectStatus.Completed;
}

@if (Model == null)
{
    <div class="page active">
        <div class="ph">
            <div class="ph-bc">👤 User / <span>My Solar Status</span></div>
            <div class="ph-title">Project Status</div>
        </div>
        <div class="card text-center" style="padding:40px">
            <h3>No active project</h3>
            <p class="text-muted">You haven't submitted a solar request yet.</p>
            <a class="btn btn-p" asp-action="Create">➕ Start a New Request</a>
        </div>
    </div>
}
else
{
    <div class="page active">
        <div class="ph">
            <div class="ph-bc">👤 User / <span>My Solar Status</span></div>
            <div class="ph-title">Project Status</div>
            <div class="ph-sub">Track your solar connection from registration through completion.</div>
        </div>

        <div class="g2" style="grid-template-columns:1.4fr 1fr;gap:14px">
            <div>
                <partial name="~/Views/Shared/_StatusTimeline.cshtml" model="Model" />
            </div>
            <div>
                @* "Activate Now" — shown ONLY for a fully-paid "Without Activation"
                   ID (spec). Hidden for With-Activation / already-active IDs. *@
                @if ((bool)(ViewBag.CanActivateNow ?? false))
                {
                    <div class="card" style="margin-bottom:14px;border-left:4px solid var(--green);background:linear-gradient(180deg,#f0fdf4,#fff)">
                        <div class="ct"><span class="ct-dot"></span>Ready to Activate</div>
                        <p class="text-muted" style="font-size:13px;margin-bottom:12px">
                            Your payments are complete. You can now activate this ID —
                            select a product and continue the activation process.
                            <strong>No further payment is needed.</strong>
                        </p>
                        <a class="btn btn-p btn-full" asp-action="Activate" asp-route-id="@Model.Id">⚡ Activate Now</a>
                    </div>
                }
                <div class="card" style="margin-bottom:14px">
                    <div class="ct"><span class="ct-dot"></span>Next Action</div>
                    @{
                        // Per spec: "user panel pe request reject ki to wapis laga sake."
                        // If admin rejected the request, the next action is to fix the
                        // issues and re-submit — override the stage-based switch below
                        // and show a dedicated "Re-submit" CTA instead.
                        if (Model.ApprovalStatus == SolarPortal.Domain.Enums.ApprovalStatus.Rejected)
                        {
                            <h6 style="color:#dc2626">❌ Request Rejected</h6>
                            <p class="text-muted" style="font-size:13px">
                                Admin has rejected your previous submission.
                                @{
                                    var rejReason = !string.IsNullOrWhiteSpace(Model.RejectionReason)
                                                        ? Model.RejectionReason
                                                        : Model.AdminNotes;
                                }
                                @if (!string.IsNullOrWhiteSpace(rejReason))
                                {
                                    <span><strong>Reason:</strong> @rejReason</span>
                                }
                                Please review the details and re-submit.
                            </p>
                            <a class="btn btn-p btn-full" asp-action="Create">🔄 Re-submit Request</a>
                        }
                        else
                        {
                            switch (Model.CurrentStage)
                            {
                                case SolarPortal.Domain.Enums.ProjectStatus.Registration:
                                case SolarPortal.Domain.Enums.ProjectStatus.ProductSelection:
                                    <h6>🛒 Select Plan & Make Payment</h6>
                                    <p class="text-muted" style="font-size:13px">Choose your solar kit (1 kW, 2 kW, etc.) and submit your first payment. <strong>Admin must verify</strong> before workflow advances.</p>
                                    <a class="btn btn-p btn-full" asp-action="Create">Solar Request & Payment</a>
                                    break;
                                case SolarPortal.Domain.Enums.ProjectStatus.Payment:
                                    <h6>💰 Make a Payment</h6>
                                    <p class="text-muted" style="font-size:13px">Submit at least ₹@minVal.ToString("N0") cumulative. <strong>Admin must verify</strong> before workflow advances.</p>
                                    if (subTotal > 0 || verTotal > 0)
                                    {
                                        <div class="card" style="background:var(--bg);padding:10px;margin:10px 0;font-size:12.5px;box-shadow:none">
                                            <div class="sr"><span class="srk">Submitted</span><span class="srv">₹@subTotal.ToString("N0")</span></div>
                                            <div class="sr"><span class="srk" style="color:var(--green)">Admin Verified</span><span class="srv" style="color:var(--green)">₹@verTotal.ToString("N0")</span></div>
                                            <div class="sr"><span class="srk">Minimum to Advance</span><span class="srv">₹@minVal.ToString("N0")</span></div>
                                        </div>
                                        if (verTotal >= minVal)
                                        {
                                            <div class="alert alert-s" style="font-size:12px"><span class="ai">✅</span>Verified total meets minimum. Refresh if stage hasn't advanced.</div>
                                        }
                                        else if (subTotal >= minVal)
                                        {
                                            <div class="alert alert-w" style="font-size:12px"><span class="ai">⏳</span>Awaiting admin to verify ₹@((minVal - verTotal).ToString("N0")) more.</div>
                                        }
                                        else
                                        {
                                            <div class="alert alert-i" style="font-size:12px"><span class="ai">ℹ</span>Need ₹@((minVal - subTotal).ToString("N0")) more in submitted payments.</div>
                                        }
                                    }
                                    <a class="btn btn-p btn-full" asp-action="Payment" asp-route-id="@Model.Id">Go to Payment</a>
                                    break;
                                case SolarPortal.Domain.Enums.ProjectStatus.PMSurvey:
                                    <h6>📋 Upload PM Surya Ghar Documents</h6>
                                    <p class="text-muted" style="font-size:13px">Upload required scheme documents for admin verification.</p>
                                    <a class="btn btn-p btn-full" asp-controller="PMSurya" asp-action="Upload" asp-route-id="@Model.Id">Upload Documents</a>
                                    break;
                                case SolarPortal.Domain.Enums.ProjectStatus.SiteSurvey:
                                    <h6>📐 Site Survey</h6>
                                    <p class="text-muted" style="font-size:13px">Download form, fill on site, then upload back with photos.</p>
                                    <a class="btn btn-p btn-full" asp-controller="SiteSurvey" asp-action="Index" asp-route-id="@Model.Id">Go to Site Survey</a>
                                    break;
                                case SolarPortal.Domain.Enums.ProjectStatus.MeterDispatch:
                                    @* Point 3: Meter Dispatch and Site Survey are open together, and
                                       the SURVEY is what moves the project on - the meter is recorded
                                       by admin whenever it happens. So the action to show here is the
                                       survey; "check back for updates" left the user waiting on
                                       something they were never blocked by. *@
                                    <h6>📐 Site Survey</h6>
                                    <p class="text-muted" style="font-size:13px">
                                        Download the form, fill it on site, then upload it back with photos.
                                        Your meter is being arranged separately — you do not have to wait for it.
                                    </p>
                                    <a class="btn btn-p btn-full" asp-controller="SiteSurvey" asp-action="Index" asp-route-id="@Model.Id">Go to Site Survey</a>
                                    break;
                                case SolarPortal.Domain.Enums.ProjectStatus.MaterialDispatch:
                                    <h6>📦 Awaiting Material Dispatch</h6>
                                    <p class="text-muted" style="font-size:13px">Solar material is being dispatched to your address.</p>
                                    break;
                                case SolarPortal.Domain.Enums.ProjectStatus.Installation:
                                    <h6>🔧 Installation In Progress</h6>
                                    <p class="text-muted" style="font-size:13px">An installer (INC) has been assigned. They'll update progress here.</p>
                                    break;
                                case SolarPortal.Domain.Enums.ProjectStatus.DCRUpdate:
                                    <h6>📄 Upload DCR Document</h6>
                                    <p class="text-muted" style="font-size:13px">Final step — upload your DCR document for admin verification.</p>
                                    <a class="btn btn-p btn-full" asp-controller="DCR" asp-action="Upload" asp-route-id="@Model.Id">Upload DCR</a>
                                    break;
                                case SolarPortal.Domain.Enums.ProjectStatus.Completed:
                                    <h6>✅ Project Complete</h6>
                                    <p style="color:var(--green);font-size:13px">Your solar installation is fully complete!</p>
                                    break;
                            }
                        }
                        @* end of else (non-rejected) *@
                    }
                </div>

                <div class="card">
                    <div class="ct"><span class="ct-dot"></span>Project Info</div>
                    <div class="sr"><span class="srk">Project</span><span class="srv">@Model.RequestNumber</span></div>
                    @if (isUnfilledStub)
                    {
                        @* Registered but no plan picked yet — show "Not selected yet"
                           for everything except the project number, exactly like the
                           Dashboard card. Mode/Plan/Connection/amounts are all hidden
                           until the user actually picks a plan. *@
                        <div class="sr"><span class="srk">Mode</span><span class="srv" style="color:#94a3b8;font-style:italic">Not selected yet</span></div>
                        <div class="sr"><span class="srk">Plan</span><span class="srv" style="color:#94a3b8;font-style:italic">Not selected yet</span></div>
                        <div class="sr"><span class="srk">Capacity</span><span class="srv" style="color:#94a3b8;font-style:italic">—</span></div>
                        <div class="sr"><span class="srk">Connection</span><span class="srv" style="color:#94a3b8;font-style:italic">Not selected yet</span></div>
                        <div class="sr" style="margin-top:6px">
                            <span class="srv" style="color:var(--text2);font-size:13px">
                                Select a plan and make your first payment to see the full project details here.
                            </span>
                        </div>
                    }
                    else
                    {
                        decimal paidVerified = 0m;
                        decimal submittedTotal = 0m;
                        try { paidVerified = (decimal)(ViewBag.VerifiedPaid ?? 0m); } catch { }
                        try { submittedTotal = (decimal)(ViewBag.TotalSubmitted ?? 0m); } catch { }
                        var totalAmt = Model.RequestedAmount;
                        var remaining = totalAmt > paidVerified ? totalAmt - paidVerified : 0m;

                        <div class="sr">
                            <span class="srk">Mode</span><span class="srv">
                            @switch (Model.RequestType)
                            {
                                case SolarPortal.Domain.Enums.RequestType.WithActivation:
                                    <text>🔌 With Activation</text>
                                    ; break;
                                case SolarPortal.Domain.Enums.RequestType.OnlySolarWithoutActivation:

                                    <text>⚡ Only Solar</text>
                                    ; break;
                                case SolarPortal.Domain.Enums.RequestType.AlreadyActiveOnlyRequest:

                                    <text>✅ Already Active</text>
                                    ; break;
                            }
                        </span>
                    </div>
                    <div class="sr"><span class="srk">Plan</span><span class="srv">@Model.SelectedPlan</span></div>
                    <div class="sr"><span class="srk">Capacity</span><span class="srv">@Model.KVCapacity kV</span></div>
                    <div class="sr"><span class="srk">Connection</span><span class="srv">@Model.ConnectionType</span></div>
                    <div class="sr"><span class="srk">Total Amount</span><span class="srv">₹@totalAmt.ToString("N0")</span></div>
                    <div class="sr"><span class="srk">Paid (Verified)</span><span class="srv" style="color:var(--green)">₹@paidVerified.ToString("N0")</span></div>
                    @if (statusDeposit > 0m)
                    {
                        <div class="sr">
                            <span class="srk">&nbsp;&nbsp;&nbsp;↳ already paid on your Active ID</span>
                            <span class="srv" style="color:var(--green)">₹@statusDeposit.ToString("N0")</span>
                        </div>
                    }
                    @if (submittedTotal > paidVerified)
                    {
                        <div class="sr"><span class="srk">Submitted (Pending)</span><span class="srv" style="color:#d97706">₹@((submittedTotal - paidVerified).ToString("N0"))</span></div>
                    }
                    <div class="sr"><span class="srk">Remaining Balance</span><span class="srv" style="color:#d97706;font-weight:600">₹@remaining.ToString("N0")</span></div>
                    @if (statusDeposit > 0m)
                    {
                        <div style="margin-top:8px;padding:8px 10px;border-radius:8px;
                                    background:#f0fdf4;border:1px solid #bbf7d0;
                                    font-size:12px;color:#166534">
                            ✅ <strong>₹@statusDeposit.ToString("N0") aap pehle de chuke ho</strong> —
                            ye aapke Active ID ke order ka amount hai, isliye ye Remaining Balance
                            me se ghata diya gaya hai. Ye baaki nahi hai.
                        </div>
                    }
                }
                @* Approval row removed on request (same as the Dashboard's Project Info
                   card) - Stage already tells the user where the project is. The
                   rejected-request CTA in "Next Action" above still uses
                   Model.ApprovalStatus, so nothing else is affected. *@
                <div class="sr"><span class="srk">Stage</span><span class="srv"><span class="sts @StageStsClass(Model.CurrentStage)">@Model.CurrentStage</span></span></div>
            </div>
            @{
                var actProduct = ViewBag.ActProduct as SolarPortal.Application.Services.BasicProductDto;
            }
            @if (actProduct != null)
            {
                decimal _projTotal = Model.RequestedAmount > 0 ? Model.RequestedAmount : actProduct.DP;
                decimal _vPaid = 0m; try { _vPaid = (decimal)(ViewBag.VerifiedPaid ?? 0m); } catch { }
                decimal _totalBV = actProduct.BV;
                decimal _paidBV = _projTotal > 0 ? Math.Round(_totalBV * Math.Min(1m, _vPaid / _projTotal), 2) : (_vPaid > 0 ? _totalBV : 0m);
                if (_paidBV > _totalBV) { _paidBV = _totalBV; }
                decimal _pendingBV = _totalBV - _paidBV;
                <div class="card" style="border-left:4px solid var(--green)">
                    <div class="ct"><span class="ct-dot"></span>Product &amp; BV</div>
                    <div class="sr"><span class="srk">Product Taken</span><span class="srv">@actProduct.ProductName</span></div>
                    <div class="sr"><span class="srk">Product DP</span><span class="srv">₹@actProduct.DP.ToString("N0")</span></div>
                    <div class="sr"><span class="srk">Total BV</span><span class="srv">@_totalBV.ToString("N2")</span></div>
                    <div class="sr"><span class="srk" style="color:var(--green)">Paid BV</span><span class="srv" style="color:var(--green)">@_paidBV.ToString("N2")</span></div>
                    <div class="sr"><span class="srk" style="color:#d97706">Pending BV</span><span class="srv" style="color:#d97706">@_pendingBV.ToString("N2")</span></div>
                    <div class="sr"><span class="srk">Claimable BV</span><span class="srv">@_paidBV.ToString("N2")</span></div>
                    <div class="hint" style="margin-top:8px">Paid BV is proportional to your verified payment.</div>
                </div>
            }        </div>
    </div>
</div>
}

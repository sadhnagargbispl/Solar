@model SolarPortal.Application.DTOs.SolarRequestDto
@{
    ViewData["Title"] = "Payment";
    var payments = (IEnumerable<SolarPortal.Application.DTOs.PaymentDto>)(ViewBag.Payments ?? Enumerable.Empty<SolarPortal.Application.DTOs.PaymentDto>());

    string PaymentStsClass(SolarPortal.Domain.Enums.PaymentStatus s) => s switch
    {
        SolarPortal.Domain.Enums.PaymentStatus.Completed => "sts-act",
        SolarPortal.Domain.Enums.PaymentStatus.Partial => "sts-disp",
        _ => "sts-pend"
    };
}

<div class="page active">
    <div class="ph">
        <div class="ph-bc">
            👤 User / <a asp-area="SolarPanelUserPanel" asp-controller="SolarRequest" asp-action="Index" style="color:var(--sun)">Projects</a> / <span>Payment</span>
        </div>
        <div class="ph-title">💰 Make Payment</div>
        <div class="ph-sub">Request @Model?.RequestNumber — complete your solar project payment</div>
    </div>

    @if (Model != null)
    {
        <div class="g2">
            <div class="card">
                <div class="ct"><span class="ct-dot"></span>Project Summary</div>
                <div class="sr"><span class="srk">Request Number</span><span class="srv">@Model.RequestNumber</span></div>
                <div class="sr"><span class="srk">Capacity</span><span class="srv">@Model.KVCapacity kV</span></div>
                <div class="sr"><span class="srk">Connection Type</span><span class="srv">@Model.ConnectionType</span></div>
                <div class="sr"><span class="srk">Selected Plan</span><span class="srv">@(Model.SelectedPlan ?? "—")</span></div>
                <div class="sr"><span class="srk">Project Amount</span><span class="srv" style="color:var(--sun)">₹@Model.RequestedAmount.ToString("N0")</span></div>
                @{
                    var totalPaid = (decimal)(ViewBag.TotalPaid ?? 0m);
                    var verified  = (decimal)(ViewBag.VerifiedPaid ?? 0m);
                    var minimum   = (decimal)(ViewBag.MinimumThreshold ?? 20000m);

                    // Image point 1 — money already deposited through the cPanel order
                    // of an already-active ID. It is a genuine credit against this
                    // project, so Due is measured against (project − deposit).
                    // 0 for every other request mode.
                    var idDeposit = (decimal)(ViewBag.ActiveIdDeposit ?? 0m);
                    var payableAmt = (decimal)(ViewBag.PayableAmount ?? Model.RequestedAmount);

                    var dueAmt    = Math.Max(0, payableAmt - totalPaid);
                    var pendingAmt = Math.Max(0, totalPaid - verified);
                    var remaining = Math.Max(0, minimum - verified);
                }
                @if (idDeposit > 0m)
                {
                    <div class="sr">
                        <span class="srk">Deposited on Active ID</span>
                        <span class="srv" style="color:var(--green)">₹@idDeposit.ToString("N0")</span>
                    </div>
                }
                <div class="sr"><span class="srk">Total Paid (Verified)</span><span class="srv" style="color:var(--green)">₹@verified.ToString("N0")</span></div>
                @if (pendingAmt > 0)
                {
                    <div class="sr"><span class="srk">Pending (Awaiting Approval)</span><span class="srv" style="color:#f59e0b">₹@pendingAmt.ToString("N0")</span></div>
                }
                <div class="sr"><span class="srk">Due</span><span class="srv" style="color:var(--sun)">₹@dueAmt.ToString("N0")</span></div>

                <div class="pay-card" style="margin-top:14px">
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px">
                        <div>
                            <div style="font-size:11px;color:#6EE7B7">Total Payable</div>
                            @* The .pay-card has a dark green background, so the big amount and
                               row values must be WHITE / light-green — `var(--green)` here is
                               the same dark green as the card and would render invisible. *@
                            <div style="font-family:Rajdhani,sans-serif;font-size:32px;font-weight:700;color:#ffffff;text-shadow:0 1px 2px rgba(0,0,0,0.3)">
                                ₹@dueAmt.ToString("N0")
                            </div>
                        </div>
                        <span style="font-size:28px">☀️</span>
                    </div>
                    <div class="pay-row">
                        <span class="prk" style="color:#bbf7d0">Project Amount</span>
                        <span class="prv" style="color:#ffffff;font-weight:600">₹@Model.RequestedAmount.ToString("N0")</span>
                    </div>
                    @* Already Submitted / Admin Verified / Minimum to Advance rows removed
                       per spec — these were confusing the user with intermediate counters.
                       The Due row below already shows the actionable balance. *@
                    <div class="pay-row" style="border-top:1px solid rgba(255,255,255,.15);padding-top:10px">
                        <span class="prk" style="color:#6EE7B7;font-weight:700">Due</span>
                        <span class="prv" style="color:#ffffff;font-size:18px;font-weight:700">₹@dueAmt.ToString("N0")</span>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="ct"><span class="ct-dot"></span>Add Payment</div>
                @* Per spec: jab project ka pura amount pay ho chuka ho (due = 0),
                   to payment form nahi dikhana — sirf ek confirmation message.
                   User ko dobara payment karne ki zaroorat nahi. *@
                @if (dueAmt <= 0 && pendingAmt <= 0)
                {
                    <div class="alert alert-s" style="margin:0">
                        <span class="ai">✅</span>
                        <div>
                            <strong>Payment complete!</strong><br />
                            Your full project amount (₹@Model.RequestedAmount.ToString("N0")) has been covered.
                            @if (idDeposit > 0m)
                            {
                                <text>₹@idDeposit.ToString("N0") of it is the amount already deposited on your active ID.</text>
                            }
                            No balance is due — no further payment is needed.
                        </div>
                    </div>
                    <a asp-area="SolarPanelUserPanel" asp-controller="SolarRequest" asp-action="Details"
                       asp-route-id="@Model.Id" class="btn btn-s" style="margin-top:14px">
                        ← Back to Project
                    </a>
                }
                else if (dueAmt <= 0 && pendingAmt > 0)
                {
                    <div class="alert alert-w" style="margin:0">
                        <span class="ai">⌛</span>
                        <div>
                            <strong>Payment submitted - verification pending.</strong><br />
                            You have submitted the full amount. ₹@pendingAmt.ToString("N0") is still pending admin verification.
                            Total Paid will update as soon as it is verified.
                        </div>
                    </div>
                    <a asp-area="SolarPanelUserPanel" asp-controller="SolarRequest" asp-action="Details"
                       asp-route-id="@Model.Id" class="btn btn-s" style="margin-top:14px">
                        ← Back to Project
                    </a>
                }
                else
                {
                @* The "Minimum ₹20,000 admin-verified" warning was removed.
                   The new rule (in PaymentsController) is full-payment-required for
                   stage advance, so showing a partial-amount minimum is misleading. *@
                <form id="paymentForm" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="SolarRequestId" value="@Model.Id" />

                    <div class="fg">
                        <label>Payment Amount <span class="req">*</span></label>
                        <div class="ig">
                            <span class="ig-pre">₹</span>
                        @{
                            // The FIRST payment has to clear the ₹20,000 minimum in one
                            // go (server enforces the same in AddPayment). Once something
                            // is already paid, a smaller top-up is fine.
                            var minThisPay = totalPaid <= 0 ? minimum : 1m;
                        }
                            <input type="number" name="Amount" id="payAmt" placeholder="@minThisPay.ToString("0")"
                                   required min="@minThisPay.ToString("0")" max="@dueAmt" data-min="@minThisPay.ToString("0")" />
                        </div>
                        <small style="color:var(--text2);font-size:11px">
                            @if (totalPaid <= 0)
                            {
                                <text>First payment must be at least ₹@minimum.ToString("N0"). </text>
                            }
                            Maximum payable: ₹@dueAmt.ToString("N0") (remaining due)
                        </small>
                    </div>

                    <div class="fr">
                        <div class="fg">
                            <label>Payment Method <span class="req">*</span></label>
                            @{
                                // Payment methods come from the legacy M_PayModeMaster
                                // table (loaded by the controller) so they match the old
                                // SolFit system exactly. We store the Paymode text as the
                                // value (the new Payment.PaymentMethod column is a string),
                                // and tag each option with its legacy Pid in data-pid for
                                // any future server-side mapping.
                                var payModes = ViewBag.PayModes
                                    as List<SolarPortal.Application.Services.PayModeDto>
                                    ?? new List<SolarPortal.Application.Services.PayModeDto>();
                            }
                            <select name="PaymentMethod" required>
                                <option value="">Select method</option>
                                @foreach (var pm in payModes)
                                {
                                    <option value="@pm.Paymode" data-pid="@pm.Pid">@pm.Paymode</option>
                                }
                            </select>
                        </div>
                        <div class="fg">
                            <label>Payment Date <span class="req">*</span></label>
                            <input type="date" name="PaymentDate" id="payDate" required />
                        </div>
                    </div>

                    @* UTR field given full width since the Reference Number partner
                       field was removed per spec. *@
                    <div class="fg">
                        <label>UTR / Transaction No.</label>
                        <input type="text" name="UTRNumber" id="payUTR" placeholder="UTR / Txn ID" />
                        @* Same live duplicate-UTR check the New Request form has, so the
                           user finds out while typing instead of only on submit. *@
                        <div id="payUtrMsg" class="hint" style="font-size:11px;margin-top:2px"></div>
                    </div>

                    <div class="fg">
                        <label>Payment Receipt (Image / PDF) <span class="req">*</span></label>
                        @* The file input is positioned absolutely over the entire
                           upload-area (see .upload-area input[type=file] in CSS).
                           Native click on the area picks the file. We must NOT
                           also wire onclick=triggerFile on the parent: that would
                           fire the picker twice (once via input bubble, once via
                           onclick), which on some browsers makes the dialog open,
                           close, and require a SECOND click to actually pick. *@
                        <div class="upload-area">
                            <input type="file" name="receiptImage" id="payReceipt" accept="image/*,.pdf"
                                   onchange="previewSingle('payReceipt','pay-prev')" />
                            <div class="upload-icon">🖼️</div>
                            <div class="upload-txt">Upload payment screenshot / receipt</div>
                            <div class="upload-hint">JPG, PNG, PDF • Max 10 MB</div>
                        </div>
                        <div id="pay-prev" style="margin-top:8px"></div>
                    </div>

                    <div class="fg">
                        <label>Notes (Optional)</label>
                        <textarea name="Notes" placeholder="Any additional info..." rows="2"></textarea>
                    </div>

                    <div class="btn-row">
                        <button type="button" id="payBtn" class="btn btn-p" onclick="submitPaymentForm(@Model.Id, this)">✓ Submit Payment</button>
                        <a asp-area="SolarPanelUserPanel" asp-controller="SolarRequest" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-s">← Cancel</a>
                    </div>
                </form>
                }
            </div>
        </div>

        @if (payments.Any())
        {
            <div class="card" style="margin-top:16px">
                <div class="ct"><span class="ct-dot"></span>Payment History (@payments.Count())</div>
                <div class="tbl-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Receipt #</th>
                                <th>Method</th>
                                <th>Amount</th>
                                <th>Reference</th>
                                <th>Document</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var pay in payments.OrderByDescending(p => p.PaymentDate))
                            {
                                <tr>
                                    <td>@pay.PaymentDate.ToString("dd/MM/yyyy")</td>
                                    <td class="td-b">@(pay.ReceiptNumber ?? "—")</td>
                                    <td>@(pay.PaymentMethod ?? "—")</td>
                                    <td style="text-align:right;color:var(--sun)">₹@pay.Amount.ToString("N0")</td>
                                    <td>@(pay.ReferenceNumber ?? pay.UTRNumber ?? "—")</td>
                                    @* The receipt image / PDF uploaded with this payment.
                                       openFileModal() normalises the stored path itself. *@
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(pay.ReceiptImagePath))
                                        {
                                            <a href="javascript:void(0)" onclick="openFileModal('@pay.ReceiptImagePath')" style="color:var(--sun)">📄 View</a>
                                        }
                                        else { <span class="text-muted">—</span> }
                                    </td>
                                    <td><span class="sts @PaymentStsClass(pay.Status)">@pay.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <div class="card" style="margin-top:16px">
            <div class="ct"><span class="ct-dot"></span>Bank Account Details</div>
            <div class="g2">
                <div>
                    <div class="sr"><span class="srk">Account Name</span><span class="srv">Solar Portal Solutions</span></div>
                    <div class="sr"><span class="srk">Account Number</span><span class="srv">123456789012</span></div>
                </div>
                <div>
                    <div class="sr"><span class="srk">IFSC Code</span><span class="srv">SBIN0001234</span></div>
                    <div class="sr"><span class="srk">Bank</span><span class="srv">State Bank of India</span></div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Default to today
        document.addEventListener('DOMContentLoaded', () => {
            const d = document.getElementById('payDate');
            if (d && !d.value) d.value = new Date().toISOString().split('T')[0];
        });

        // ── UTR real-time availability check ─────────────────────────────
        // Mirrors the New Request form: as the user types (or tabs away) the UTR
        // is checked against walletreq.chqno and Payments.UTRNumber, so a
        // duplicate is caught here instead of only when Submit is pressed.
        // utrState is read by submitPaymentForm() below to refuse a known-bad UTR.
        let utrState = { checked: '', available: true, message: '' };

        document.addEventListener('DOMContentLoaded', () => {
            const utrInput = document.getElementById('payUTR');
            const utrMsg   = document.getElementById('payUtrMsg');
            if (!utrInput || !utrMsg) return;
            let utrTimer = null;

            function clearMsg() {
                utrMsg.textContent = '';
                utrInput.style.borderColor = '';
                utrState = { checked: '', available: true, message: '' };
            }

            function runUtrCheck() {
                const v = (utrInput.value || '').trim();
                if (!v) { clearMsg(); return; }

                utrMsg.style.color = '#64748b';
                utrMsg.textContent = 'Checking UTR…';

                fetch('@Url.Action("CheckUtr", "SolarRequest", new { area = "SolarPanelUserPanel" })?utr=' + encodeURIComponent(v))
                    .then(r => r.json())
                    .then(data => {
                        utrState = { checked: v, available: !!data.available, message: data.message || '' };
                        if (data.available) {
                            utrMsg.style.color = '#16a34a';
                            utrMsg.textContent = '✓ UTR is available.';
                            utrInput.style.borderColor = '#16a34a';
                        } else {
                            utrMsg.style.color = '#dc2626';
                            utrMsg.textContent = '✗ ' + (data.message || 'This UTR is already used. Please use a different one.');
                            utrInput.style.borderColor = '#dc2626';
                        }
                    })
                    .catch(() => clearMsg());
            }

            utrInput.addEventListener('blur', runUtrCheck);
            utrInput.addEventListener('input', () => {
                clearTimeout(utrTimer);
                clearMsg();
                utrTimer = setTimeout(runUtrCheck, 600);
            });
        });

        // This posts with fetch(), so the site-wide form-submit guard in
        // submit-once.js does not see it - we borrow its lock explicitly via
        // window.solarSubmitGuard. Double-clicking used to create two payment
        // rows for the same money.
        async function submitPaymentForm(requestId, btn) {
            btn = btn || document.getElementById('payBtn');
            const form = document.getElementById('paymentForm');
            const fd = new FormData(form);
            const amt = fd.get('Amount');
            const amtInput = document.getElementById('payAmt');
            const minPay = parseFloat(amtInput?.dataset.min || '1');

            if (!amt || parseFloat(amt) <= 0) { showError('Please enter a valid amount'); return; }
            if (parseFloat(amt) < minPay) {
                showError(`First payment must be at least ₹${minPay.toLocaleString('en-IN')}.`);
                return;
            }
            const recv = document.getElementById('payReceipt');
            if (!recv || !recv.files || !recv.files[0]) { showError('Please upload payment receipt'); return; }

            // The live check above already told us this UTR is taken - stop here
            // rather than making the user wait for the server to say the same.
            // (AddPayment still re-checks server-side; this is only a shortcut.)
            const utrNow = (fd.get('UTRNumber') || '').toString().trim();
            if (utrNow && utrState.checked === utrNow && !utrState.available) {
                showError(utrState.message || 'This UTR is already used. Please use a different one.');
                return;
            }

            // Lock only AFTER validation passes, so a fixable mistake doesn't
            // leave the button dead. A false return means a submit is already
            // running, so this click is a duplicate.
            if (!window.solarSubmitGuard(btn)) return;
            const unlock = () => window.solarSubmitGuard.release(btn);

            try {
                const r = await fetch('/SolarPanelUserPanel/SolarRequest/AddPayment', { method: 'POST', body: fd });
                if (!r.ok) throw new Error('HTTP ' + r.status);
                const d = await r.json();
                if (d.success) {
                    showSuccess(d.message || 'Payment submitted!');
                    // Stay locked - the page reloads in a moment and a second
                    // submit here would duplicate the payment.
                    setTimeout(() => location.reload(), 1500);
                } else {
                    showError(d.message || 'Failed to submit payment');
                    unlock();
                }
            } catch (e) {
                showError('Network error');
                unlock();
            }
        }
    </script>
}

@* In-page preview for the uploaded payment receipt (defines openFileModal). *@
@await Html.PartialAsync("_FileModal")

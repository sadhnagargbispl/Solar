@model CreateSolarRequestViewModel
@{
    ViewData["Title"] = "New Solar Request";
    var projects = (IEnumerable<SolarPortal.Application.DTOs.SolarProjectDto>)(ViewBag.Projects ?? Enumerable.Empty<SolarPortal.Application.DTOs.SolarProjectDto>());
}

<div class="page active">
    <div class="ph">
        <div class="ph-bc">👤 User / <span>New Solar Connection Request</span></div>
        <div class="ph-title">➕ Solar Connection Request</div>
        <div class="ph-sub">Fill in all details to submit your solar connection application</div>
    </div>

    <div class="tabs" id="req-tabs" style="display:none">
        <div class="tab active" onclick="switchTab('req',0,this)">① Activation &amp; Info</div>
        <div class="tab" onclick="switchTab('req',1,this)">② Product &amp; Plan</div>
        <div class="tab" onclick="switchTab('req',2,this)">③ Review &amp; Submit</div>
    </div>

    <!-- All sections shown together on one page (no step navigation) -->
    <style>
        .tc { display: block; }
        .tc + .tc { margin-top: 18px; }
        /* Active-member gating: visually grey out + block clicks on locked mode cards */
        .rc.disabled-card {
            opacity: 0.45;
            cursor: not-allowed !important;
            background: #f9fafb;
            border-style: dashed !important;
            pointer-events: auto;   /* keep auto so onclick handler fires the warning toast */
        }
        .rc.disabled-card:hover { transform: none !important; box-shadow: none !important; }
    </style>

    <form asp-area="SolarPanelUserPanel" asp-controller="SolarRequest" asp-action="Create" method="post"
          enctype="multipart/form-data" id="requestForm" novalidate>
        @Html.AntiForgeryToken()

        @* ===== Resubmission banner =====
           If the user is re-filling a previously-rejected request, show the
           admin's reject reason at the top so they know what to fix. The
           controller sets ViewBag.RejectionNote on the GET when the existing
           request has ApprovalStatus = Rejected. *@
        @if (ViewBag.RejectionNote is string rn && !string.IsNullOrWhiteSpace(rn))
        {
            <div class="alert alert-w" style="background:#fef3c7;border-left:4px solid #f59e0b;color:#92400e;padding:14px 18px;margin-bottom:16px;border-radius:6px">
                <strong>⚠ Your previous request was rejected.</strong>
                <div style="margin-top:6px;font-size:14px">
                    <strong>Admin note:</strong> @rn
                </div>
                <div style="margin-top:8px;font-size:13px;opacity:0.85">
                    Please review the details below, fix what the admin flagged, and submit again.
                </div>
            </div>
        }

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-e">
                <span class="ai">⚠</span>
                <div>
                    <strong>Please fix these errors:</strong>
                    <ul style="margin:6px 0 0 18px;padding:0">
                        @foreach (var entry in ViewData.ModelState)
                        {
                            foreach (var err in entry.Value!.Errors)
                            {
                                <li>@(string.IsNullOrEmpty(entry.Key) ? "" : entry.Key + ": ")@err.ErrorMessage</li>
                            }
                        }
                    </ul>
                </div>
            </div>
        }

        <!-- TAB 0 -->
        <div class="tc active" id="req-0">
            <div class="g2">
                <div class="card">
                    <div class="ct"><span class="ct-dot"></span>Activation Type</div>
                    @{
                        // Per spec: agar user m_membermaster.ActiveStatus = 'Y' hai,
                        // user already an active solar member hai — sirf
                        // "Already Active — Only Request" mode allowed hai.
                        // Other two cards visually disable + click block, hidden
                        // input ko 3 set kar deta hai.
                        bool isActiveMem = (bool)(ViewBag.IsActiveMember ?? false);
                        // Default hidden input value: 3 if active member, else from model (or 1).
                        var defaultReqType = isActiveMem ? 3 : (int)Model.RequestType;
                    }
                    <div class="fg">
                        <label>Request Type <span class="req">*</span></label>
                        <input type="hidden" asp-for="RequestType" id="reqTypeInput" value="@defaultReqType" />
                        @if (isActiveMem)
                        {
                            <div class="alert alert-i" style="font-size:13px;margin-bottom:8px">
                                <span class="ai">ℹ</span>You are an existing active solar member. Only the "Already Active — Only Request" mode is available for your account.
                            </div>
                        }
                        <div class="rc-group">
                            <div class="rc @(isActiveMem ? "disabled-card" : (defaultReqType == 1 ? "sel" : ""))"
                                 data-val="1"
                                 onclick="@(isActiveMem ? "blockedByActiveMember()" : "selectRequestType(this,1)")"
                                 title="@(isActiveMem ? "Not available — you are already an active member" : "")">
                                <div class="rci">🔌</div><div class="rcl">With Activation</div><div class="rcs">New KYC</div>
                                @if (isActiveMem) { <div class="rcs" style="color:#dc2626;font-size:11px;margin-top:4px">🔒 Locked</div> }
                            </div>
                            <div class="rc @(isActiveMem ? "disabled-card" : (defaultReqType == 2 ? "sel" : ""))"
                                 data-val="2"
                                 onclick="@(isActiveMem ? "blockedByActiveMember()" : "selectRequestType(this,2)")"
                                 title="@(isActiveMem ? "Not available — you are already an active member" : "")">
                                <div class="rci">⚡</div><div class="rcl">Only Solar</div><div class="rcs">Without activation</div>
                                @if (isActiveMem) { <div class="rcs" style="color:#dc2626;font-size:11px;margin-top:4px">🔒 Locked</div> }
                            </div>
                            <div class="rc @(defaultReqType == 3 ? "sel" : "")"
                                 data-val="3"
                                 onclick="selectRequestType(this,3)">
                                <div class="rci">✅</div><div class="rcl">Already Active</div><div class="rcs">Solar only</div>
                            </div>
                        </div>
                    </div>
                    <div class="fr">
                        <div class="fg">
                            <label asp-for="KVCapacity">Solar Type <span class="req">*</span></label>
                            @{
                                // Build the dropdown from the actual DB plans so the
                                // KV value the user picks always matches a real
                                // SolarProject row — otherwise the auto-amount lookup
                                // silently fails and saves PlanAmount = 0.
                                var plansList = ViewBag.Projects as IEnumerable<SolarPortal.Application.DTOs.SolarProjectDto>
                                                ?? Enumerable.Empty<SolarPortal.Application.DTOs.SolarProjectDto>();
                                var uniqueKvs = plansList
                                    .Select(p => p.SolarTypeKV)
                                    .Distinct()
                                    .OrderBy(kv => kv)
                                    .ToList();
                            }
                            <select asp-for="KVCapacity" onchange="onKvChange(this.value)">
                                @if (!uniqueKvs.Any())
                                {
                                    <option value="">-- No plans available --</option>
                                }
                                else
                                {
                                    foreach (var kv in uniqueKvs)
                                    {
                                        <option value="@kv">@kv kV — @(kv <= 2 ? "Domestic Small" : kv <= 5 ? "Standard" : kv <= 7 ? "Medium" : "Commercial")</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="fg">
                            <label asp-for="ConnectionType">Connection Type <span class="req">*</span></label>
                            <select asp-for="ConnectionType">
                                <option value="1">Domestic</option>
                                <option value="2">Commercial</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="ct"><span class="ct-dot"></span>Customer Information</div>
                    @{
                        // Per spec: "Name & Address profile se auto-fill and readonly rakho."
                        // The controller sets ViewBag.ProfileReadonly = true after pulling values
                        // from the bridged MMemberMaster + ApplicationUser.
                        //
                        // Razor cannot inject a standalone HTML attribute via @variable inside
                        // a tag helper's attribute area (causes RZ1031). The supported pattern
                        // is to render the attribute conditionally with a value that's either
                        // present or null — null attributes are dropped by Razor at render time.
                        bool roProfile = (bool)(ViewBag.ProfileReadonly ?? false);
                        string? roReadonly = roProfile ? "readonly" : null;
                        string  roStyle    = roProfile ? "background:#f3f4f6;color:#374151;cursor:not-allowed" : "";
                    }
                    <div class="fg">
                        <label asp-for="ApplicantName">Full Name <span class="req">*</span></label>
                        <input asp-for="ApplicantName" placeholder="Customer full name"
                               readonly="@roReadonly" style="@roStyle" />
                        <span asp-validation-for="ApplicantName" class="hint" style="color:var(--danger)"></span>
                        @if (roProfile) { <div class="hint" style="font-size:11px">🔒 Auto-filled from your profile</div> }
                    </div>
                    <div class="fr">
                        <div class="fg">
                            <label asp-for="MobileNumber">Mobile No. <span class="req">*</span></label>
                            <input asp-for="MobileNumber" type="tel" placeholder="10-digit mobile" maxlength="10"
                                   readonly="@roReadonly" style="@roStyle" />
                            <div class="hint">⚠ Not editable after submit</div>
                            <span asp-validation-for="MobileNumber" class="hint" style="color:var(--danger)"></span>
                        </div>
                        <div class="fg">
                            <label asp-for="Email">Email <span class="req">*</span></label>
                            <input asp-for="Email" type="email" placeholder="Email address" id="emailInput" />
                            <span asp-validation-for="Email" class="hint" style="color:var(--danger)"></span>
                            <div id="emailCheckMsg" class="hint" style="font-size:11px;margin-top:2px"></div>
                        </div>
                    </div>
                    <div class="fg">
                        <label asp-for="Address">Address <span class="req">*</span></label>
                        <textarea asp-for="Address" placeholder="House No, Street, Area..."
                                  readonly="@roReadonly" style="@roStyle"></textarea>
                        @if (roProfile) { <div class="hint" style="font-size:11px">🔒 Auto-filled from your profile</div> }
                    </div>
                    <div class="fr3">
                        <div class="fg">
                            <label asp-for="City">City <span class="req">*</span></label>
                            <input asp-for="City" placeholder="Jaipur" readonly="@roReadonly" style="@roStyle" />
                        </div>
                        <div class="fg">
                            <label asp-for="State">State <span class="req">*</span></label>
                            @{
                                // States from the legacy M_StateDivMaster table so the
                                // dropdown matches the old SolFit system (per spec).
                                var stateList = ViewBag.States
                                    as List<SolarPortal.Application.Services.StateDto>
                                    ?? new List<SolarPortal.Application.Services.StateDto>();
                            }
                            @if (roProfile && !string.IsNullOrWhiteSpace(Model.State))
                            {
                                <input asp-for="State" readonly="readonly" style="@roStyle" />
                            }
                            else
                            {
                                <select asp-for="State">
                                    <option value="">Select</option>
                                    @foreach (var st in stateList)
                                    {
                                        <option value="@st.StateName" data-code="@st.StateCode">@st.StateName</option>
                                    }
                                </select>
                            }
                        </div>
                        <div class="fg">
                            <label asp-for="PinCode">Pin Code <span class="req">*</span></label>
                            <input asp-for="PinCode" placeholder="302001" maxlength="6"
                                   readonly="@roReadonly" style="@roStyle" />
                            <span asp-validation-for="PinCode" class="hint" style="color:var(--danger)"></span>
                        </div>
                    </div>

                    @* Aadhaar + PAN removed from this form per spec.
                       Values still sit on the model (preserved for the auto-stub case) so we
                       keep them as hidden inputs to round-trip the data without showing it. *@
                    <input type="hidden" asp-for="AadharNumber" />
                    <input type="hidden" asp-for="PANNumber" />

                    @* "Location" (GPS photo) upload removed from this form per spec. *@
                </div>
            </div>
        </div>

        <!-- Mode 2 banner — Only Solar Without Activation -->
        <div id="mode2Banner" class="card" style="display:none;background:#fef3c7;border-left:4px solid #f59e0b;margin-bottom:12px">
            <div style="display:flex;align-items:flex-start;gap:12px">
                <span style="font-size:24px">⚡</span>
                <div style="flex:1">
                    <div style="font-weight:600;color:#92400e;margin-bottom:4px">Only Solar — Without Activation</div>
                    <div style="color:var(--text2);font-size:13px">
                        Pick your Solar Type and Connection Type — total amount auto-fills from the
                        matching plan. Admin must verify your payment before the workflow advances.
                    </div>
                    <div id="mode2AmountBox" style="margin-top:10px;padding:10px 14px;background:#fff;border-radius:6px;border:1px solid #fcd34d;display:none">
                        <div style="font-size:12px;color:#92400e;font-weight:500">Matched Plan</div>
                        <div id="mode2PlanName" style="font-weight:600;color:#0f172a;margin-top:2px">—</div>
                        <div style="display:flex;justify-content:space-between;align-items:center;margin-top:8px">
                            <span style="font-size:12px;color:var(--text2)">Total Amount</span>
                            <span id="mode2Amount" style="font-size:18px;font-weight:700;color:#0f172a">₹0</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Mode 3 banner — Already Active -->
        <div id="mode3Banner" class="card" style="display:none;background:var(--accent-light);border-left:4px solid var(--accent);margin-bottom:12px">
            <div style="display:flex;align-items:flex-start;gap:12px">
                <span style="font-size:24px">✅</span>
                <div style="flex:1">
                    <div style="font-weight:600;color:var(--accent-dark);margin-bottom:4px">Already Active — Only Request mode</div>
                    <div style="color:var(--text2);font-size:13px">
                        You already have an active Solar Account. Project selection is skipped — just submit your
                        details and payment. Admin will approve the request and link it to your existing account.
                    </div>
                    @* Per spec: Already Active mode bhi Without Activation jaisa
                       Matched Plan (project name + connection + amount) dikhaye.
                       The amount + name auto-fill from the matching kV master plan,
                       exactly like Mode 2. populated by applyFetchedPlan(). *@
                    <div id="mode3AmountBox" style="margin-top:10px;padding:10px 14px;background:#fff;border-radius:6px;border:1px solid var(--accent);display:none">
                        <div style="font-size:12px;color:var(--accent-dark);font-weight:500">Matched Plan</div>
                        <div id="mode3PlanName" style="font-weight:600;color:#0f172a;margin-top:2px">—</div>
                        <div style="display:flex;justify-content:space-between;align-items:center;margin-top:6px">
                            <span style="font-size:12px;color:var(--text2)">Total Amount</span>
                            <span id="mode3Amount" style="font-size:18px;font-weight:700;color:#0f172a">₹0</span>
                        </div>
                    </div>
                    @* Shown when no active kW master plan matches the selected Solar
                       Type + Connection — tells the user/admin the plan is missing
                       instead of silently showing no amount. *@
                    <div id="noPlanBox" style="margin-top:10px;padding:10px 14px;background:#fff7ed;border-radius:6px;border:1px solid #fdba74;display:none">
                        <div style="font-size:13px;color:#9a3412">
                            ⚠ No price is set for this Solar Type + Connection yet.
                            Please ask the admin to add a matching plan, or pick another Solar Type.
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB 1 -->
        <div class="tc active" id="req-1">
            @{
                // Per spec: "With Activation me basic products show karo."
                // Pull the basic-product list from V#SpProductDetail (legacy view) via
                // the controller. In With Activation mode the user picks one of these
                // cards; the controller re-fetches DP server-side from the chosen ProdId.
                var basicProducts = (ViewBag.BasicProducts as List<SolarPortal.Application.Services.BasicProductDto>)
                                    ?? new List<SolarPortal.Application.Services.BasicProductDto>();
                // Server-side initial visibility for the basic-products section and the
                // payment summary card. If the form opens defaulted to Already Active
                // (mode 3) — e.g. for an active m_membermaster user — neither section
                // is relevant and would confuse the user, so we render them hidden.
                // JS keeps them in sync if the user switches modes later.
                var initialReqType = (int)Model.RequestType;
                var hideProductSections = (initialReqType == 2 || initialReqType == 3);
                var initialHideStyle = hideProductSections ? "display:none" : "";
            }
            <input type="hidden" asp-for="SolarProjectId" id="solarProjectIdInput" />
            <input type="hidden" asp-for="SelectedPlan" id="selectedPlanInput" />
            <input type="hidden" asp-for="PlanAmount" id="planAmountInput" />
            <input type="hidden" asp-for="ExternalProductId" id="externalProductIdInput" />

            <!-- Basic products picker — only shown in With Activation mode -->
            <div class="card" id="basicProductsCard" style="@initialHideStyle">
                <div class="ct"><span class="ct-dot"></span>Select Basic Product</div>
                <div class="alert alert-i" style="font-size:13px">
                    <span class="ai">ℹ</span>Pick one of the basic products below. The Dealer Price (DP) shown is your payable amount.
                </div>
                @if (basicProducts.Any())
                {
                    <div class="bp-grid">
                        @foreach (var p in basicProducts)
                        {
                            var outOfStock = p.Stock <= 0;
                            var saving = p.MRP - p.DP;
                            var pct = p.MRP > 0 ? (int)Math.Round((double)(saving) / (double)p.MRP * 100) : 0;
                            <div class="bp-card basic-product-card @(outOfStock ? "out-of-stock" : "")"
                                 data-prodid="@p.ProdId"
                                 data-name="@p.ProductName"
                                 data-dp="@p.DP.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                 data-mrp="@p.MRP.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                 onclick="@(outOfStock ? "" : "selectBasicProduct(this)")">
                                @if (!outOfStock && pct > 0)
                                {
                                    <span class="bp-badge">@pct% OFF</span>
                                }
                                <div class="bp-tick basic-product-tick">✓</div>
                                <div class="bp-icon">🔆</div>
                                <div class="bp-name">@p.ProductName</div>
                                <div class="bp-prices">
                                    <span class="bp-mrp">₹@p.MRP.ToString("N0")</span>
                                    <span class="bp-dp">₹@p.DP.ToString("N0")</span>
                                </div>
                                @if (!outOfStock && saving > 0)
                                {
                                    <div class="bp-save">You save ₹@saving.ToString("N0")</div>
                                }
                                @if (outOfStock)
                                {
                                    <div class="bp-oos">Out of stock</div>
                                }
                            </div>
                        }
                    </div>
                    <span asp-validation-for="ExternalProductId" class="hint" style="color:var(--danger);margin-top:6px;display:block"></span>

                    <style>
                        /* ── Basic-product premium cards ── */
                        .bp-grid {
                            display: grid;
                            grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
                            gap: 14px;
                            margin-top: 10px;
                        }
                        .bp-card {
                            position: relative;
                            background: #fff;
                            border: 2px solid #e5e7eb;
                            border-radius: 14px;
                            padding: 20px 16px 16px;
                            text-align: center;
                            cursor: pointer;
                            transition: transform .15s ease, box-shadow .15s ease, border-color .15s ease;
                            overflow: hidden;
                        }
                        .bp-card::before {
                            content: "";
                            position: absolute;
                            top: 0; left: 0; right: 0;
                            height: 4px;
                            background: linear-gradient(90deg, #16a34a, #22c55e, #4ade80);
                            opacity: 0;
                            transition: opacity .15s ease;
                        }
                        .bp-card:hover {
                            transform: translateY(-4px);
                            box-shadow: 0 10px 24px rgba(22,163,74,.15);
                            border-color: #bbf7d0;
                        }
                        .bp-card:hover::before { opacity: 1; }
                        /* Selected state (JS toggles .sel) */
                        .bp-card.sel {
                            border-color: #16a34a;
                            box-shadow: 0 8px 24px rgba(22,163,74,.25);
                            background: linear-gradient(180deg, #f0fdf4 0%, #ffffff 60%);
                        }
                        .bp-card.sel::before { opacity: 1; }
                        .bp-badge {
                            position: absolute;
                            top: 10px; left: 10px;
                            background: #dc2626;
                            color: #fff;
                            font-size: 11px;
                            font-weight: 700;
                            padding: 3px 8px;
                            border-radius: 20px;
                            letter-spacing: .3px;
                        }
                        .bp-tick {
                            position: absolute;
                            top: 8px; right: 10px;
                            width: 26px; height: 26px;
                            border-radius: 50%;
                            background: #16a34a;
                            color: #fff;
                            font-size: 15px;
                            line-height: 26px;
                            text-align: center;
                            display: none;
                            box-shadow: 0 2px 6px rgba(22,163,74,.4);
                        }
                        .bp-card.sel .bp-tick { display: block; }
                        .bp-icon {
                            font-size: 40px;
                            margin: 6px 0 10px;
                            line-height: 1;
                        }
                        .bp-name {
                            font-weight: 600;
                            font-size: 13px;
                            color: #111827;
                            min-height: 34px;
                            display: flex;
                            align-items: center;
                            justify-content: center;
                            line-height: 1.3;
                        }
                        .bp-prices {
                            margin-top: 10px;
                            display: flex;
                            align-items: baseline;
                            justify-content: center;
                            gap: 8px;
                        }
                        .bp-mrp {
                            color: #9ca3af;
                            text-decoration: line-through;
                            font-size: 13px;
                        }
                        .bp-dp {
                            color: #16a34a;
                            font-weight: 800;
                            font-size: 22px;
                            font-family: Rajdhani, sans-serif;
                        }
                        .bp-save {
                            margin-top: 6px;
                            display: inline-block;
                            background: #dcfce7;
                            color: #15803d;
                            font-size: 11px;
                            font-weight: 600;
                            padding: 3px 10px;
                            border-radius: 20px;
                        }
                        .bp-oos {
                            margin-top: 8px;
                            color: #dc2626;
                            font-size: 12px;
                            font-weight: 600;
                        }
                        .bp-card.out-of-stock {
                            opacity: .55;
                            cursor: not-allowed;
                            filter: grayscale(.4);
                        }
                        .bp-card.out-of-stock:hover {
                            transform: none;
                            box-shadow: none;
                            border-color: #e5e7eb;
                        }
                        .bp-card.out-of-stock:hover::before { opacity: 0; }
                    </style>
                }
                else
                {
                    <div class="alert alert-w">
                        <span class="ai">⚠</span>No basic products available right now. Please contact admin.
                    </div>
                }
            </div>

            <div class="card" id="paymentSummaryCard" style="margin-top:14px;@initialHideStyle">
                <div class="ct"><span class="ct-dot"></span>Payment Summary</div>
                <div class="pay-card" style="margin-top:12px">
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px">
                        <div>
                            <div style="font-size:11px;color:#6EE7B7">Total Payable (DP)</div>
                            @* Amount color forced to white — the pay-card has a green
                               background, and the old color:var(--green) rendered green
                               text on green, making ₹30,000 nearly invisible. *@
                            <div id="planAmountDisplay" style="font-family:Rajdhani,sans-serif;font-size:32px;font-weight:700;color:#ffffff">
                                ₹0
                            </div>
                        </div>
                        <span style="font-size:28px">☀️</span>
                    </div>
                    <div class="pay-row"><span class="prk">Solar Project</span><span class="prv" id="selectedPlanDisplay">—</span></div>
                    <div class="pay-row"><span class="prk">Connection Type</span><span class="prv" id="connTypeDisplay">Domestic</span></div>
                    <div class="pay-row"><span class="prk">Capacity</span><span class="prv" id="kvDisplay">— kV</span></div>
                </div>
            </div>
        </div>

        <!-- TAB 2 -->
        <div class="tc active" id="req-2">
            @* Customer Summary & Project Summary cards removed per spec.
               The Payment Summary card on TAB 1 already shows the auto-matched plan + amount. *@

            <!-- === Combined first-payment block (per spec: request + payment in one form) === -->
            <div class="card" style="margin-top:14px">
                <div class="ct"><span class="ct-dot"></span>First Payment</div>
                <div class="alert alert-i" style="font-size:13px">
                    <span class="ai">ℹ</span>Minimum first payment is <strong>₹20,000</strong>. Cannot exceed project amount.
                    Payment is saved as <strong>Pending</strong> — admin will verify it.
                </div>

                <div class="fr">
                    <div class="fg">
                        <label asp-for="PaymentAmount">Payment Amount <span class="req">*</span></label>
                        <input asp-for="PaymentAmount" id="paymentAmountInput" type="number" min="20000" step="1" placeholder="20000" />
                        <span asp-validation-for="PaymentAmount" class="hint" style="color:var(--danger)"></span>
                    </div>
                    <div class="fg">
                        <label asp-for="PaymentUTR">UTR / Transaction No. <span class="req">*</span></label>
                        <input asp-for="PaymentUTR" id="paymentUtrInput" maxlength="50" placeholder="UTR / TXN ID" autocomplete="off" />
                        <span asp-validation-for="PaymentUTR" class="hint" style="color:var(--danger)"></span>
                        <div id="utrCheckMsg" class="hint" style="margin-top:4px;font-size:12px"></div>
                    </div>
                </div>
                <div class="fr">
                    <div class="fg">
                        <label asp-for="PaymentDate">Payment Date <span class="req">*</span></label>
                        <input asp-for="PaymentDate" type="date" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="fg">
                        @* Payment Method made mandatory per spec: "Payment Method mandatory karo." *@
                        <label asp-for="PaymentMethod">Payment Method <span class="req">*</span></label>
                        @{
                            // Same legacy M_PayModeMaster source as the standalone
                            // Payment page, so the With Activation inline payment uses
                            // identical options.
                            var createPayModes = ViewBag.PayModes
                                as List<SolarPortal.Application.Services.PayModeDto>
                                ?? new List<SolarPortal.Application.Services.PayModeDto>();
                        }
                        <select asp-for="PaymentMethod" id="paymentMethodInput" required>
                            <option value="">Select method</option>
                            @foreach (var pm in createPayModes)
                            {
                                <option value="@pm.Paymode" data-pid="@pm.Pid">@pm.Paymode</option>
                            }
                        </select>
                        <span asp-validation-for="PaymentMethod" class="hint" style="color:var(--danger)"></span>
                    </div>
                </div>

                <div class="fg">
                    <label>Payment Receipt (Image / PDF) <span class="req">*</span></label>
                    <div class="upload-area">
                        <input type="file" asp-for="PaymentReceipt" id="paymentReceiptInput" accept="image/*,.pdf"
                               onchange="previewReceiptPreview(this)" />
                        <div class="upload-icon">🧾</div>
                        <div class="upload-txt">Upload payment screenshot / receipt</div>
                        <div class="upload-hint">JPG, PNG, PDF • Max 10 MB</div>
                        <div id="receiptPreview" style="margin-top:8px;font-size:12px;color:var(--text2)">
                            @if (!string.IsNullOrEmpty(ViewBag.PreservedReceiptName as string))
                            {
                                <text>⚠ Previously selected: <strong>@ViewBag.PreservedReceiptName</strong>. Please re-attach — browser security clears the file input after page reload.</text>
                            }
                        </div>
                    </div>
                    <span asp-validation-for="PaymentReceipt" class="hint" style="color:var(--danger);margin-top:6px;display:block"></span>
                </div>
            </div>

            <div class="card" style="margin-top:14px">
                <div class="alert alert-s" style="font-size:13px">
                    <span class="ai">✅</span>Submit will save your solar request AND first payment together.
                </div>
                <div class="btn-row" style="justify-content:center">
                    <button type="submit" class="btn btn-p" style="padding:12px 32px;font-size:15px" onclick="return confirmSubmit()">☀️ Submit Application &amp; Payment</button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        // Submit logging for debug — surfaces client-side block reasons in console
        document.addEventListener('DOMContentLoaded', () => {
            const form = document.getElementById('requestForm');
            if (form) form.addEventListener('submit', (e) => {
                console.log('[SolarRequest] Submitting form. SolarProjectId=' +
                    (document.getElementById('solarProjectIdInput')?.value || '(empty)') +
                    ' Plan=' + (document.getElementById('selectedPlanInput')?.value || '(empty)') +
                    ' Amount=' + (document.getElementById('planAmountInput')?.value || '(empty)'));
            });

            // On first load, the Solar Type / mode are ALREADY selected (e.g. an
            // active member is locked to "Already Active" with 2 kV pre-chosen).
            // Run the plan match right away so the matched amount shows without the
            // user having to re-click the dropdown. We use the already-set
            // RequestType to decide which mode box to fill.
            const reqType = parseInt(document.getElementById('reqTypeInput')?.value || '0', 10);
            const banner2 = document.getElementById('mode2Banner');
            const banner3 = document.getElementById('mode3Banner');
            if (reqType === 2 && banner2) banner2.style.display = 'block';
            if (reqType === 3 && banner3) banner3.style.display = 'block';
            // Fill the matched-plan box + hidden inputs from the current Solar Type
            // + Connection Type (works for every mode).
            if (typeof applyFetchedPlan === 'function') applyFetchedPlan();
            // Keep the kV display label in sync too.
            const kvSel = document.querySelector('[name="KVCapacity"]');
            const kvDisp = document.getElementById('kvDisplay');
            if (kvSel && kvDisp) kvDisp.textContent = kvSel.value + ' kV';
        });
    </script>
    <script>
        function rcSel(el, group) {
            el.closest('.rc-group').querySelectorAll('.rc').forEach(r => r.classList.remove('sel'));
            el.classList.add('sel');
        }

        // Called when an active member (m_membermaster.ActiveStatus = 'Y') tries
        // to click the locked With Activation / Only Solar cards. Show a toast and
        // do nothing else — the hidden RequestType input stays at 3 (Already Active).
        function blockedByActiveMember() {
            if (typeof showWarning === 'function') {
                showWarning('Aap pehle se active solar member hain. Sirf "Already Active — Only Request" mode allowed hai.');
            } else {
                alert('Aap pehle se active solar member hain. Sirf "Already Active — Only Request" mode allowed hai.');
            }
            return false;
        }

        function selectRequestType(el, val) {
            el.closest('.rc-group').querySelectorAll('.rc').forEach(r => r.classList.remove('sel'));
            el.classList.add('sel');
            document.getElementById('reqTypeInput').value = val;

            // Modes 2 & 3 both skip project plan selection — request is logged
            // directly against the user's existing solar profile.
            const planTab      = document.getElementById('req-1');
            const basicCard    = document.getElementById('basicProductsCard');
            const paySumCard   = document.getElementById('paymentSummaryCard');
            const banner2      = document.getElementById('mode2Banner');
            const banner3      = document.getElementById('mode3Banner');
            const v = parseInt(val, 10);

            if (v === 2 || v === 3) {
                // Already Active (3) and Only Solar (2): user is not picking a basic
                // product, so hide the product picker + the big payment-summary card.
                // BUT per spec the project amount + plan still come from the kV master
                // plan — so we DON'T zero it out. applyFetchedPlan() (called below)
                // fills the mode's own Matched-Plan box and the hidden inputs from the
                // selected Solar Type + Connection Type.
                if (basicCard)  basicCard.style.display  = 'none';
                if (paySumCard) paySumCard.style.display = 'none';
                document.getElementById('externalProductIdInput').value = '';
            } else {
                // Mode 1: With Activation — show both sections so user can pick a product
                // and see the payable amount.
                if (basicCard)  basicCard.style.display  = '';
                if (paySumCard) paySumCard.style.display = '';
                if (planTab)    planTab.style.display    = '';
            }

            if (banner2) banner2.style.display = (v === 2) ? 'block' : 'none';
            if (banner3) banner3.style.display = (v === 3) ? 'block' : 'none';

            // Fill the matched-plan box (and hidden inputs) from the current Solar
            // Type + Connection Type for the active mode. Runs for all modes so the
            // project amount is always the kV master-plan amount.
            applyFetchedPlan();
        }

        // === Basic Product picker ===
        // Per spec, in With Activation mode the user picks one of these products.
        // We set the hidden ExternalProductId and the Payment Summary card to the DP.
        // SelectedPlan is set to the product name for display purposes.
        function selectBasicProduct(el) {
            // Clear other selections
            document.querySelectorAll('.basic-product-card').forEach(c => {
                c.classList.remove('sel');
                const tick = c.querySelector('.basic-product-tick');
                if (tick) tick.style.display = 'none';
            });
            el.classList.add('sel');
            const tick = el.querySelector('.basic-product-tick');
            if (tick) tick.style.display = '';

            const prodId = el.dataset.prodid;

            // Per spec: "With activation ho ya without ya already active — sabhi
            // mein project amount 1 kW / 2 kW (KV master plan) se hi hoga."
            //
            // So the basic product the user picks here is ONLY recorded as the
            // legacy-bridge product (ExternalProductId) — it does NOT set the
            // project amount. The project amount + capacity always come from the
            // KV master plan the user chose in "Solar Type" (handled by
            // applyFetchedPlan / selectPlanFromMaster). We therefore do NOT touch
            // planAmountInput, selectedPlanInput, the amount display, or kvDisplay.
            document.getElementById('externalProductIdInput').value = prodId;

            // Re-apply the KV master plan so the summary reflects the kW amount,
            // not the product DP. (applyFetchedPlan now skips when ExternalProductId
            // is set, so we call the master-plan lookup directly here instead.)
            applyKvMasterPlanToSummary();
        }

        // Sets the Payment Summary (amount / plan name / capacity) from the KV
        // master plan currently chosen in the Solar Type dropdown. Used by the
        // basic-product picker so picking a product never overrides the kW amount.
        function applyKvMasterPlanToSummary() {
            const m = fetchMatchingPlan();
            if (!m) return;
            document.getElementById('solarProjectIdInput').value = m.id;
            document.getElementById('planAmountInput').value     = m.amount;
            // selectedPlanInput keeps the kW plan name as the project's plan.
            document.getElementById('selectedPlanInput').value   = m.name;

            const disp = document.getElementById('planAmountDisplay');
            if (disp) disp.textContent = '₹' + Number(m.amount).toLocaleString('en-IN');
            const planLbl = document.getElementById('selectedPlanDisplay');
            if (planLbl) planLbl.textContent = m.name;
            const kvDisp = document.getElementById('kvDisplay');
            if (kvDisp) kvDisp.textContent = m.kv + ' kV';
            const payAmt = document.getElementById('paymentAmountInput');
            if (payAmt) payAmt.setAttribute('max', m.amount);
        }

        function selectPlanFromMaster(el) {
            el.closest('.fg').querySelectorAll('.rc').forEach(r => r.classList.remove('sel'));
            el.classList.add('sel');
            const id = el.dataset.id;
            const name = el.dataset.name;
            const amount = parseFloat(el.dataset.amount || 0);
            const kv = el.dataset.kv;
            const conn = el.dataset.conn;
            document.getElementById('solarProjectIdInput').value = id;
            document.getElementById('selectedPlanInput').value = name;
            document.getElementById('planAmountInput').value = amount;
            // Sync the kv + connection-type form fields too
            const kvSel = document.querySelector('[name="KVCapacity"]');
            if (kvSel) kvSel.value = kv;
            // NOTE: Intentionally do NOT overwrite ConnectionType when a plan is
            // clicked — the user has already made an explicit choice (Domestic /
            // Commercial). Overwriting it would silently change their selection.
            // Update summary card
            document.getElementById('planAmountDisplay').textContent = '₹' + amount.toLocaleString('en-IN');
            document.getElementById('selectedPlanDisplay').textContent = name;
            document.getElementById('kvDisplay').textContent = kv + ' kV';
            // Reflect the user's chosen ConnectionType (not the plan's) since we no
            // longer overwrite the dropdown when a plan card is clicked.
            const curConn = document.querySelector('[name="ConnectionType"]')?.value || conn;
            document.getElementById('connTypeDisplay').textContent = curConn === '1' ? 'Domestic' : 'Commercial';
        }

        // === Plans master data embedded for client-side amount lookup ===
        // When user changes Solar Type (KV) or Connection Type, we auto-pick the matching
        // plan and update the Project Amount everywhere on the page.
        const PLANS = [
@foreach (var p in projects)
{
            <text>{ id: @p.Id, name: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(p.Name)), kv: @p.SolarTypeKV.ToString(System.Globalization.CultureInfo.InvariantCulture), conn: @((int)p.ConnectionType), amount: @p.ProjectAmount.ToString(System.Globalization.CultureInfo.InvariantCulture) },</text>
}
        ];

        function fetchMatchingPlan() {
            const kv = parseFloat(document.querySelector('[name="KVCapacity"]')?.value || '0');
            const conn = parseInt(document.querySelector('[name="ConnectionType"]')?.value || '1', 10);
            if (!kv) return null;
            // Tolerant kV compare (2 vs 2.00 vs 2.0) — avoid exact-float mismatch.
            const sameKv = (a, b) => Math.abs(parseFloat(a) - parseFloat(b)) < 0.001;
            // Exact KV+conn, else KV only, else conn only
            return PLANS.find(p => sameKv(p.kv, kv) && p.conn === conn)
                ?? PLANS.find(p => sameKv(p.kv, kv))
                ?? PLANS.find(p => p.conn === conn)
                ?? null;
        }

        function applyFetchedPlan() {
            // Project amount always comes from the KV master plan — in every mode
            // (With Activation, Without, Already Active). The basic product picker
            // only records ExternalProductId for the legacy bridge; it never sets
            // the amount. So this lookup runs normally regardless of whether a
            // product is selected.
            const m = fetchMatchingPlan();
            const noPlanBox = document.getElementById('noPlanBox');
            if (!m) {
                // Nothing matched — clear the Mode 2 / Mode 3 live amount boxes
                const m2box = document.getElementById('mode2AmountBox');
                if (m2box) m2box.style.display = 'none';
                const m3box = document.getElementById('mode3AmountBox');
                if (m3box) m3box.style.display = 'none';
                // Tell the user no price is configured (instead of showing nothing).
                if (noPlanBox) noPlanBox.style.display = 'block';
                // Also clear the amount so a stale value isn't submitted.
                document.getElementById('planAmountInput').value = '';
                return;
            }
            if (noPlanBox) noPlanBox.style.display = 'none';
            // Update hidden inputs so backend gets the correct values
            document.getElementById('solarProjectIdInput').value = m.id;
            document.getElementById('selectedPlanInput').value = m.name;
            document.getElementById('planAmountInput').value = m.amount;
            // Update visible displays
            const disp = document.getElementById('planAmountDisplay');
            if (disp) disp.textContent = '₹' + Number(m.amount).toLocaleString('en-IN');
            const planLbl = document.getElementById('selectedPlanDisplay');
            if (planLbl) planLbl.textContent = m.name;
            // Highlight the matching plan card in Mode 1 picker
            document.querySelectorAll('.rc[data-id]').forEach(c => {
                if (parseInt(c.dataset.id, 10) === m.id) c.classList.add('sel');
                else c.classList.remove('sel');
            });
            // Update payment max
            const payAmt = document.getElementById('paymentAmountInput');
            if (payAmt) payAmt.setAttribute('max', m.amount);

            // Mode 2 live amount box
            const m2box  = document.getElementById('mode2AmountBox');
            const m2name = document.getElementById('mode2PlanName');
            const m2amt  = document.getElementById('mode2Amount');
            if (m2box) {
                m2box.style.display = 'block';
                if (m2name) m2name.textContent = m.name + (m.conn === 1 ? ' (Domestic)' : ' (Commercial)');
                if (m2amt)  m2amt.textContent  = '₹' + Number(m.amount).toLocaleString('en-IN');
            }

            // Mode 3 (Already Active) live amount box — same content as Mode 2 so
            // the user sees the matched plan name + connection + amount here too.
            const m3box  = document.getElementById('mode3AmountBox');
            const m3name = document.getElementById('mode3PlanName');
            const m3amt  = document.getElementById('mode3Amount');
            if (m3box) {
                m3box.style.display = 'block';
                if (m3name) m3name.textContent = m.name + (m.conn === 1 ? ' (Domestic)' : ' (Commercial)');
                if (m3amt)  m3amt.textContent  = '₹' + Number(m.amount).toLocaleString('en-IN');
            }
        }

        function onKvChange(kv) {
            const kvDisplay = document.getElementById('kvDisplay');
            if (kvDisplay) kvDisplay.textContent = kv + ' kV';
            applyFetchedPlan();
        }

        // Also react to Connection Type changes

        function validateStep0() {
            // Per spec: "User n blank detail h to sab blank jaani chahiye,
            // Aadhaar/PAN/profile fields ke koi required nahi aana chahiye."
            //
            // Profile fields (Name, Mobile, Email, Address, City, State, PinCode)
            // are readonly in the UI — fed from the user's ApplicationUser /
            // MMemberMaster row. If they're blank in the source, the user has no
            // way to fill them, so blocking the tab transition would be a dead-end.
            // We just advance to the next tab and let the server take whatever
            // values came through (including empty strings).
            switchTab('req', 1, document.querySelectorAll('#req-tabs .tab')[1]);
        }

        function confirmSubmit() {
            // Plan check: Mode 1 (With Activation) now requires a basic product pick.
            // Modes 2 & 3 skip product selection — the backend auto-matches.
            const reqType = parseInt(document.getElementById('reqTypeInput').value, 10);
            const extProdId = (document.getElementById('externalProductIdInput')?.value || '').trim();
            if (reqType === 1 && !extProdId) {
                showWarning('Please pick one of the basic products in the "Select Basic Product" section.');
                return false;
            }

            // === Email validation removed per spec ===
            // "Email PAN sab valid form me na ho to bhi le le."
            // Profile fields are readonly and may carry weird/legacy/blank
            // values. Server accepts whatever we send. We no longer block on
            // format mismatch — that would create a dead-end the user can't fix.
            //
            // (Server-side, the controller also strips any ModelState errors
            // on profile fields via the fieldsToIgnoreErrors scrub.)

            // === Payment validation (all 3 modes) ===
            const payAmt    = parseFloat(document.getElementById('paymentAmountInput').value || '0');
            const payUtr    = (document.querySelector('[name="PaymentUTR"]')?.value || '').trim();
            const payDate   = (document.querySelector('[name="PaymentDate"]')?.value || '').trim();
            const payMethod = (document.getElementById('paymentMethodInput')?.value || '').trim();
            const payFile   = document.getElementById('paymentReceiptInput')?.files?.length || 0;
            const planAmt   = parseFloat(document.getElementById('planAmountInput').value || '0');

            // Effective minimum = min(₹20,000, project amount).
            const hardMin = 20000;
            const effMin  = (planAmt > 0 && planAmt < hardMin) ? planAmt : hardMin;

            if (!payAmt || payAmt < effMin) {
                const label = (planAmt > 0 && planAmt < hardMin)
                    ? `Payment must be the full project amount of ₹${effMin.toLocaleString('en-IN')}.`
                    : `Minimum payment is ₹${hardMin.toLocaleString('en-IN')}. Please enter a valid amount.`;
                showWarning(label);
                return false;
            }
            if (planAmt > 0 && payAmt > planAmt) {
                showWarning(`Payment ₹${payAmt.toLocaleString('en-IN')} cannot exceed project amount ₹${planAmt.toLocaleString('en-IN')}.`);
                return false;
            }
            if (!payUtr)    { showWarning('UTR / Transaction Number is required.'); return false; }
            if (!payDate)   { showWarning('Payment Date is required.'); return false; }
            if (!payMethod) { showWarning('Payment Method is required.'); return false; }
            if (!payFile)   { showWarning('Please upload the payment receipt image / PDF.'); return false; }

            return true;
        }

        // Receipt file preview helper for the combined payment block
        function previewReceiptPreview(input) {
            const box = document.getElementById('receiptPreview');
            if (!box) return;
            if (!input.files || !input.files.length) { box.textContent = ''; return; }
            const f = input.files[0];
            box.textContent = `📎 ${f.name} (${(f.size / 1024).toFixed(1)} KB)`;
        }

        // Init defaults on load
        document.addEventListener('DOMContentLoaded', () => {
            const kv = document.querySelector('[name="KVCapacity"]');
            if (kv) onKvChange(kv.value);

            // Hook Connection Type change → re-fetch matching plan
            const conn = document.querySelector('[name="ConnectionType"]');
            if (conn) conn.addEventListener('change', applyFetchedPlan);

            // Fire once at startup so Project Amount populates even when user
            // hasn't touched the KV / Connection Type selectors yet.
            applyFetchedPlan();

            // ── UTR real-time availability check ─────────────────────────
            // When the user types a UTR and tabs away, ping the server. If the
            // UTR exists in walletreq.chqno or Payments.UTRNumber, show an
            // inline error so they can fix it before submit.
            const utrInput = document.getElementById('paymentUtrInput');
            const utrMsg   = document.getElementById('utrCheckMsg');
            let utrTimer   = null;

            function runUtrCheck() {
                if (!utrInput || !utrMsg) return;
                const v = (utrInput.value || '').trim();
                if (!v) { utrMsg.textContent = ''; utrInput.style.borderColor = ''; return; }

                utrMsg.style.color = '#64748b';
                utrMsg.textContent = 'Checking UTR…';

                fetch('@Url.Action("CheckUtr", "SolarRequest", new { area = "SolarPanelUserPanel" })?utr=' + encodeURIComponent(v))
                    .then(r => r.json())
                    .then(data => {
                        if (data.available) {
                            utrMsg.style.color = '#16a34a';
                            utrMsg.textContent = '✓ UTR is available.';
                            utrInput.style.borderColor = '#16a34a';
                        } else {
                            utrMsg.style.color = '#dc2626';
                            utrMsg.textContent = '✗ ' + (data.message || 'This UTR is already used. Please use a different one.');
                            utrInput.style.borderColor = '#dc2626';
                        }
                    })
                    .catch(() => {
                        utrMsg.textContent = '';
                        utrInput.style.borderColor = '';
                    });
            }

            if (utrInput) {
                // Run on blur (when user tabs away) and 600ms after typing stops
                utrInput.addEventListener('blur', runUtrCheck);
                utrInput.addEventListener('input', () => {
                    clearTimeout(utrTimer);
                    utrMsg.textContent = '';
                    utrInput.style.borderColor = '';
                    utrTimer = setTimeout(runUtrCheck, 600);
                });
            }
        });
    </script>
}

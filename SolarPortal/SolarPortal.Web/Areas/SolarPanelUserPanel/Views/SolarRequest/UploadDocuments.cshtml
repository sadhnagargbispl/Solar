@{
    ViewData["Title"] = "Upload Documents";
    int requestId = (int)(ViewBag.RequestId ?? 0);
    string requestNumber = (string)(ViewBag.RequestNumber ?? "");
    bool isDomestic = (bool)(ViewBag.IsDomestic ?? true);
}

<div class="page active">
    <div class="ph">
        <div class="ph-bc">👤 User / <span>Upload Documents</span></div>
        <div class="ph-title">📁 Upload KYC &amp; Project Documents</div>
        <div class="ph-sub">Request @requestNumber — upload all required documents to proceed</div>
    </div>

    @Html.AntiForgeryToken()

    <div class="g2">
        <!-- KYC Documents -->
        <div class="card">
            <div class="section-t">① KYC Documents</div>

            @{
                var kycDocs = new[] {
                    ("doc-aadhar", "AadharCard", "🪪", "Aadhar Card", true),
                    ("doc-pan",    "PANCard",    "💳", "PAN Card",    true),
                    ("doc-bank",   "BankPassbook","🏦","Bank Passbook", true),
                    ("doc-bill",   "LightBill",  "💡", "Latest Light Bill", true)
                };
            }

            @foreach (var (inputId, docType, icon, label, required) in kycDocs)
            {
                <div class="fg">
                    <label>@label @if (required) { <span class="req">*</span> }</label>
                    <div class="upload-area">
                        <input type="file" id="@inputId" accept="image/*,.pdf" data-camera
                               onchange="previewDoc('@inputId','prev-@inputId','@docType.ToLower()')" />
                        <div class="upload-icon">@icon</div>
                        <div class="upload-txt">Upload @label</div>
                        <div class="upload-hint">PDF or Image</div>
                    </div>
                    <div id="prev-@inputId" style="margin-top:6px"></div>
                    <div id="ocr-@docType.ToLower()" class="hidden"></div>
                    <div id="status-@inputId" style="font-size:11px;margin-top:4px"></div>
                    <button type="button" class="btn btn-s btn-sm" style="margin-top:6px"
                            onclick="uploadDocument(@requestId, '@docType', '@inputId', 'status-@inputId')">
                        ⬆ Upload @label
                    </button>
                </div>
            }
        </div>

        <!-- Property & DCR -->
        <div class="card">
            <div class="section-t">② Property &amp; Site Documents</div>

            <div class="fg">
                <label>Property Document <span class="req">*</span>
                    <span style="font-size:10px;color:var(--text3)">(Farad / पट्टा / Registry)</span>
                </label>
                <div class="upload-area">
                    <input type="file" id="doc-prop" accept="image/*,.pdf" data-camera
                           onchange="previewSingle('doc-prop','prev-prop')" />
                    <div class="upload-icon">🏠</div>
                    <div class="upload-txt">Upload Property Document</div>
                    <div class="upload-hint">PDF or Image • Only 1 document</div>
                </div>
                <div id="prev-prop"></div>
                <div id="status-doc-prop" style="font-size:11px;margin-top:4px"></div>
                <button type="button" class="btn btn-s btn-sm" style="margin-top:6px"
                        onclick="uploadDocument(@requestId, 'PropertyDocument', 'doc-prop', 'status-doc-prop')">
                    ⬆ Upload Document
                </button>
            </div>

            <div class="fg">
                <label>GPS Photo <span class="req">*</span></label>
                <div class="upload-area">
                    <input type="file" id="doc-gps" accept="image/*" data-camera
                           onchange="previewSingle('doc-gps','prev-gps')" />
                    <div class="upload-icon">📍</div>
                    <div class="upload-txt">Upload GPS Location Photo</div>
                    <div class="upload-hint">Image only</div>
                </div>
                <div id="prev-gps"></div>
                <div id="status-doc-gps" style="font-size:11px;margin-top:4px"></div>
                <button type="button" class="btn btn-s btn-sm" style="margin-top:6px"
                        onclick="uploadDocument(@requestId, 'GPSPhoto', 'doc-gps', 'status-doc-gps')">
                    ⬆ Upload GPS Photo
                </button>
            </div>

            @if (isDomestic)
            {
                @* DCR upload removed from the user side - the DCR document is
                   uploaded by the ADMIN panel at the DCR Update stage. *@
                <div class="alert alert-i" style="margin-top:14px">
                    <span class="ai">ℹ</span>Your DCR document is handled by the admin at the DCR Update stage — you do not have to upload it.
                </div>
            }
        </div>
    </div>

    <div class="card" style="margin-top:16px">
        <div class="alert alert-i">
            <span class="ai">ℹ</span>All documents uploaded? Continue to make your advance payment.
        </div>
        <div class="btn-row">
            <a asp-area="SolarPanelUserPanel" asp-controller="SolarRequest" asp-action="Index" class="btn btn-s">
                🏗️ My Projects
            </a>
            <a asp-area="SolarPanelUserPanel" asp-controller="SolarRequest" asp-action="Status" asp-route-id="@requestId" class="btn btn-s">
                📍 Track Status
            </a>
            <a asp-area="SolarPanelUserPanel" asp-controller="SolarRequest" asp-action="Payment" asp-route-id="@requestId" class="btn btn-p">
                💰 Continue to Payment →
            </a>
        </div>
    </div>
</div>

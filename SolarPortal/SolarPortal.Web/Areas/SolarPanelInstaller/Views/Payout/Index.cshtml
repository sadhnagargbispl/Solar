@model List<SolarPortal.Application.Services.IncWalletEntry>
@{
    ViewData["Title"] = "Wallet";
    var balance = (decimal)(ViewBag.Balance ?? 0m);
    var credits = Model.Where(e => e.IsCredit).Sum(e => e.Amount);
    var debits = Model.Where(e => !e.IsCredit).Sum(e => e.Amount);
}
<div class="page active">
    <div class="ph">
        <div class="ph-bc">Installer / <span>Wallet</span></div>
        <div class="ph-title">INC Wallet</div>
        <div class="ph-sub">Every mark-complete installation is credited here — equal to the INC commission amount set on the plan.</div>
    </div>

    <div class="g4" style="margin-bottom:18px">
        <div class="sc">
            <div class="sc-label">Wallet Balance</div>
            <div class="sc-val green">&#8377;@balance.ToString("N2")</div>
            <div class="sc-sub">Credits minus debits</div>
        </div>
        <div class="sc">
            <div class="sc-label">Total Credited</div>
            <div class="sc-val blue">&#8377;@credits.ToString("N2")</div>
            <div class="sc-sub">@Model.Count(e => e.IsCredit) entry(s)</div>
        </div>
        <div class="sc">
            <div class="sc-label">Total Debited</div>
            <div class="sc-val gold">&#8377;@debits.ToString("N2")</div>
            <div class="sc-sub">@Model.Count(e => !e.IsCredit) entry(s)</div>
        </div>
        <div class="sc">
            <div class="sc-label">Entries</div>
            <div class="sc-val blue">@Model.Count</div>
            <div class="sc-sub">Wallet statement</div>
        </div>
    </div>

    <div class="card">
        <div class="ct"><span class="ct-dot"></span>Wallet Statement (@Model.Count)</div>
        @if (!Model.Any())
        {
            <div class="text-muted" style="text-align:center;padding:26px">
                No wallet entries yet. When you Mark Complete an installation,
                that plan's commission will be credited here.
            </div>
        }
        else
        {
            <div class="tbl-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Voucher No</th>
                            <th>Narration</th>
                            <th>Reference</th>
                            <th style="text-align:right">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in Model)
                        {
                            <tr>
                                <td>@(e.Date == DateTime.MinValue ? "—" : e.Date.ToLocalTime().ToString("dd MMM yyyy"))</td>
                                <td class="td-b">@(string.IsNullOrWhiteSpace(e.VoucherNo) ? "—" : e.VoucherNo)</td>
                                <td style="font-size:12.5px">@e.Narration</td>
                                <td style="font-size:12px;color:#6b7280">@(string.IsNullOrWhiteSpace(e.RefNo) ? "—" : e.RefNo)</td>
                                <td style="text-align:right;font-weight:600;color:@(e.IsCredit ? "var(--green)" : "#dc2626")">
                                    @(e.IsCredit ? "+" : "−")&#8377;@e.Amount.ToString("N2")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

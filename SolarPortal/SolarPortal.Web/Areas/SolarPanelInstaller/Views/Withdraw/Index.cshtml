@{
    ViewData["Title"] = "Withdraw";
    var available = (decimal)(ViewBag.Available ?? 0m);
    var banks = ViewBag.Banks as List<SolarPortal.Application.Services.BankDto>
                ?? new List<SolarPortal.Application.Services.BankDto>();
}
<div class="page active">
    <div class="ph">
        <div class="ph-bc">Installer / <span>Withdraw</span></div>
        <div class="ph-title">Withdraw</div>
        <div class="ph-sub">Request a payout from your available balance. Admin approves / rejects each request.</div>
    </div>

    @* KYC gates the withdrawal, not the earning. Say it here so the Request
       button is never a trap that only fails after it is pressed. *@
    @if (!string.IsNullOrEmpty(ViewBag.KycBlock as string))
    {
        <div class="card" style="margin-bottom:14px;border-left:4px solid #dc2626;background:#fef2f2">
            <div style="padding:12px 14px;font-size:13.5px;color:#991b1b">
                🔒 <strong>Withdrawal is on hold until your KYC is approved</strong>
                <div style="margin-top:6px">@ViewBag.KycBlock</div>
                <a class="btn btn-p btn-sm" asp-controller="Kyc" asp-action="Index" style="margin-top:10px">Open My KYC</a>
            </div>
        </div>
    }

    <div class="card">
        <div class="ct"><span class="ct-dot"></span>Request Withdrawal</div>
        <div class="sr">
            <span class="srk">Available Balance</span>
            <span class="srv" style="color:#d97706;font-weight:600">&#8377;@available.ToString("N2")</span>
        </div>
        <form asp-area="SolarPanelInstaller" asp-controller="Withdraw" asp-action="Request" method="post" style="margin-top:12px">
            @Html.AntiForgeryToken()
            <div class="g2" style="grid-template-columns:1fr 1fr;gap:14px;align-items:start">
                <div class="fg">
                    <label>Amount <span class="req">*</span></label>
                    <input type="number" name="amount" step="0.01" min="1" max="@available" placeholder="Enter amount" required />
                    <div class="hint">Cannot exceed available balance &#8377;@available.ToString("N2").</div>
                </div>
                <div class="fg">
                    <label>Bank <span class="req">*</span></label>
                    <select name="bankName" required>
                        <option value="">Select Bank</option>
                        @foreach (var b in banks)
                        {
                            <option value="@b.BankName">@b.BankName</option>
                        }
                    </select>
                    @if (!banks.Any())
                    {
                        <div class="hint">Bank list is unavailable right now.</div>
                    }
                </div>
                <div class="fg">
                    <label>Account No <span class="req">*</span></label>
                    <input type="text" name="accountNo" maxlength="50" placeholder="Enter account number" required />
                </div>
                <div class="fg">
                    <label>IFSC Code <span class="req">*</span></label>
                    <input type="text" name="ifsCode" maxlength="30" placeholder="e.g. SBIN0001234"
                           style="text-transform:uppercase" required />
                </div>
                <div class="fg">
                    <label>Branch Name</label>
                    <input type="text" name="branchName" maxlength="150" placeholder="Enter branch name" />
                </div>
            </div>
            <button type="submit" class="btn btn-p btn-full" @(available <= 0 ? "disabled" : "")>Request Withdrawal</button>
            @if (available <= 0)
            {
                <div class="hint" style="text-align:center;margin-top:6px">No balance available yet.</div>
            }
        </form>
    </div>

    @* Past requests live on their own paged page now (Withdraw/Report), reachable
       from the "Withdrawal Report" item in the sidebar. *@
    <div style="margin-top:14px;text-align:center">
        <a class="btn btn-s" asp-area="SolarPanelInstaller" asp-controller="Withdraw" asp-action="Report">View Withdrawal Report</a>
    </div>
</div>

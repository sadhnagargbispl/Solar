@model SolarPortal.Domain.Entities.IncConnection
@{ ViewData["Title"] = "New Connection"; }
<div class="page active">
    <div class="ph">
        <div class="ph-bc">Installer / <span>New Installer</span></div>
        <div class="ph-title">New Installer / Connection</div>
        <div class="ph-sub">Enter the connection details and upload the document. Status starts as Pending.</div>
    </div>

    <form asp-area="SolarPanelInstaller" asp-controller="Connections" asp-action="Create" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div class="card">
            <div class="ct"><span class="ct-dot"></span>Connection Details</div>
            <div class="fr">
                <div class="fg"><label>Customer Name <span class="req">*</span></label><input asp-for="CustomerName" required placeholder="Customer full name" /></div>
                <div class="fg"><label>Mobile No. <span class="req">*</span></label><input asp-for="MobileNumber" required maxlength="10" placeholder="10-digit mobile" /></div>
            </div>
            <div class="fg"><label>Address</label><textarea asp-for="Address" placeholder="House No, Street, Area..."></textarea></div>
            <div class="fr3">
                <div class="fg"><label>City</label><input asp-for="City" /></div>
                <div class="fg"><label>State</label><input asp-for="State" /></div>
                <div class="fg"><label>Capacity (kV)</label><input asp-for="KVCapacity" type="number" step="0.01" min="0" /></div>
            </div>
            <div class="fg">
                <label>Connection Type <span class="req">*</span></label>
                <select asp-for="ConnectionType"><option value="1">Domestic</option><option value="2">Commercial</option></select>
            </div>
            <div class="fg">
                <label>Upload Document</label>
                <div class="upload-area">
                    <input type="file" name="document" accept="image/*,.pdf" />
                    <div class="upload-icon">&#128196;</div>
                    <div class="upload-txt">Upload connection document</div>
                    <div class="upload-hint">JPG, PNG, PDF</div>
                </div>
            </div>
        </div>
        <div class="card">
            <div class="btn-row" style="justify-content:center">
                <button type="submit" class="btn btn-p" style="padding:12px 32px">Submit Connection</button>
                <a class="btn btn-s" asp-area="SolarPanelInstaller" asp-controller="Connections" asp-action="Index">Cancel</a>
            </div>
        </div>
    </form>
</div>
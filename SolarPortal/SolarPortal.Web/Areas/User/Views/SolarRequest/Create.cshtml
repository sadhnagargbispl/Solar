@model CreateSolarRequestViewModel
@{
    ViewData["Title"] = "New Solar Request";
}

<div class="page active">
    <div class="ph">
        <div class="ph-bc">👤 User / <span>New Request</span></div>
        <div class="ph-title">➕ New Solar Connection Request</div>
        <div class="ph-sub">Fill in the details to apply for solar connection</div>
    </div>

    <!-- TABS -->
    <div class="tabs" id="req-tabs">
        <div class="tab active" onclick="switchTab('req',0,this)">① Personal Info</div>
        <div class="tab" onclick="switchTab('req',1,this)">② Product & Payment</div>
        <div class="tab" onclick="switchTab('req',2,this)">③ Documents</div>
        <div class="tab" onclick="switchTab('req',3,this)">④ Review & Submit</div>
    </div>

    <form asp-area="User" asp-controller="SolarRequest" asp-action="Create" method="post"
          enctype="multipart/form-data" id="requestForm">
        @Html.AntiForgeryToken()

        <!-- TAB 0: PERSONAL INFO -->
        <div class="tc active" id="req-0">
            <div class="g2">
                <div class="card">
                    <div class="ct"><span class="ct-dot"></span>Applicant Details</div>
                    <div class="fr">
                        <div class="fg">
                            <label asp-for="ApplicantName">Full Name <span class="req">*</span></label>
                            <input asp-for="ApplicantName" placeholder="Ramesh Kumar" />
                            <span asp-validation-for="ApplicantName" class="text-danger hint"></span>
                        </div>
                        <div class="fg">
                            <label asp-for="MobileNumber">Mobile Number <span class="req">*</span></label>
                            <input asp-for="MobileNumber" type="tel" placeholder="9876543210" maxlength="10" />
                            <span asp-validation-for="MobileNumber" class="text-danger hint"></span>
                        </div>
                    </div>
                    <div class="fr">
                        <div class="fg">
                            <label asp-for="AlternateMobile">Alternate Mobile</label>
                            <input asp-for="AlternateMobile" type="tel" placeholder="Optional" />
                        </div>
                        <div class="fg">
                            <label asp-for="Email">Email <span class="req">*</span></label>
                            <input asp-for="Email" type="email" placeholder="email@example.com" />
                            <span asp-validation-for="Email" class="text-danger hint"></span>
                        </div>
                    </div>
                    <div class="fg">
                        <label asp-for="Address">Full Address <span class="req">*</span></label>
                        <textarea asp-for="Address" placeholder="House No, Street, Area..."></textarea>
                        <span asp-validation-for="Address" class="text-danger hint"></span>
                    </div>
                    <div class="fr3">
                        <div class="fg">
                            <label asp-for="City">City <span class="req">*</span></label>
                            <input asp-for="City" placeholder="Jaipur" />
                        </div>
                        <div class="fg">
                            <label asp-for="State">State <span class="req">*</span></label>
                            <select asp-for="State">
                                <option value="">Select State</option>
                                <option>Rajasthan</option>
                                <option>Gujarat</option>
                                <option>Maharashtra</option>
                                <option>Uttar Pradesh</option>
                                <option>Madhya Pradesh</option>
                                <option>Delhi</option>
                            </select>
                        </div>
                        <div class="fg">
                            <label asp-for="PinCode">Pin Code <span class="req">*</span></label>
                            <input asp-for="PinCode" placeholder="302001" maxlength="6" />
                            <span asp-validation-for="PinCode" class="text-danger hint"></span>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="ct"><span class="ct-dot"></span>KYC Identity</div>
                    <div class="fr">
                        <div class="fg">
                            <label asp-for="AadharNumber">Aadhar Number</label>
                            <input asp-for="AadharNumber" id="aadhar-field" placeholder="12 digit number" maxlength="12" />
                            <span asp-validation-for="AadharNumber" class="text-danger hint"></span>
                        </div>
                        <div class="fg">
                            <label asp-for="PANNumber">PAN Number</label>
                            <input asp-for="PANNumber" id="pan-field" placeholder="ABCDE1234F" maxlength="10"
                                   style="text-transform:uppercase" />
                            <span asp-validation-for="PANNumber" class="text-danger hint"></span>
                        </div>
                    </div>

                    <div class="fg">
                        <label>GPS / Location Photo</label>
                        <div class="upload-area" onclick="triggerFile('gps-file')">
                            <input type="file" id="gps-file" name="GPSPhoto" accept="image/*"
                                   onchange="previewSingle('gps-file','gps-preview')"
                                   style="opacity:0;position:absolute" />
                            <div class="upload-icon">📍</div>
                            <div class="upload-txt">Upload GPS Location Photo</div>
                            <div class="upload-hint">Image file • Max 5MB</div>
                        </div>
                        <div id="gps-preview" style="margin-top:8px"></div>
                    </div>

                    <div class="alert alert-i" style="margin-top:12px">
                        <span class="ai">ℹ</span>
                        Your KYC documents will be uploaded separately in Step 3
                    </div>
                </div>
            </div>

            <div class="btn-row">
                <button type="button" class="btn btn-p"
                        onclick="validateStep0()">
                    Next: Product & Payment →
                </button>
            </div>
        </div>

        <!-- TAB 1: PRODUCT & PAYMENT -->
        <div class="tc" id="req-1">
            <div class="g2">
                <div class="card">
                    <div class="ct"><span class="ct-dot"></span>Select Product Plan</div>

                    <div class="fg">
                        <label>Connection Type <span class="req">*</span></label>
                        <div class="rc-group">
                            <div class="rc sel" onclick="selectConnType(this,'Domestic')">
                                <div class="rci">🏠</div>
                                <div class="rcl">Domestic</div>
                                <div class="rcs">Residential</div>
                            </div>
                            <div class="rc" onclick="selectConnType(this,'Commercial')">
                                <div class="rci">🏢</div>
                                <div class="rcl">Commercial</div>
                                <div class="rcs">Business</div>
                            </div>
                        </div>
                        <input type="hidden" asp-for="ConnectionType" id="connTypeInput" value="1" />
                    </div>

                    <div class="fg">
                        <label asp-for="KVCapacity">KV Capacity <span class="req">*</span></label>
                        <select asp-for="KVCapacity" onchange="updatePlanAmount(this.value)">
                            <option value="1.1">1.1 kV — Domestic Small</option>
                            <option value="3">3 kV — Standard</option>
                            <option value="5">5 kV — Commercial Small</option>
                            <option value="10">10 kV — Commercial Medium</option>
                        </select>
                    </div>

                    <div class="fg">
                        <label>Select Plan <span class="req">*</span></label>
                        <div style="display:flex;flex-direction:column;gap:8px;margin-top:6px">
                            <div class="rc sel" onclick="selectPlan(this,'Plan A',15900)"
                                 style="text-align:left;display:flex;align-items:center;gap:12px;padding:12px">
                                <span style="font-size:22px">⚡</span>
                                <div>
                                    <div class="rcl">Plan A — ₹15,900</div>
                                    <div class="rcs">Low BV • 1.1 kV Domestic</div>
                                </div>
                            </div>
                            <div class="rc" onclick="selectPlan(this,'Plan B',19900)"
                                 style="text-align:left;display:flex;align-items:center;gap:12px;padding:12px">
                                <span style="font-size:22px">🔆</span>
                                <div>
                                    <div class="rcl">Plan B — ₹19,900</div>
                                    <div class="rcs">100 BV • Standard plan</div>
                                </div>
                            </div>
                            <div class="rc" onclick="selectPlan(this,'Plan C',29900)"
                                 style="text-align:left;display:flex;align-items:center;gap:12px;padding:12px">
                                <span style="font-size:22px">🌟</span>
                                <div>
                                    <div class="rcl">Plan C — ₹29,900</div>
                                    <div class="rcs">200 BV • Premium plan</div>
                                </div>
                            </div>
                        </div>
                        <input type="hidden" asp-for="SelectedPlan" id="selectedPlanInput" />
                        <input type="hidden" asp-for="PlanAmount" id="planAmountInput" />
                    </div>
                </div>

                <div class="card">
                    <div class="ct"><span class="ct-dot"></span>Payment Summary</div>

                    <div class="alert alert-w">
                        <span class="ai">⚠</span>
                        Minimum ₹20,000 payment required to proceed
                    </div>

                    <div class="pay-card" id="paymentSummary" style="margin-bottom:14px">
                        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px">
                            <div>
                                <div style="font-size:11px;color:#6EE7B7">Total Payable</div>
                                <div id="planAmountDisplay" style="font-family:Rajdhani,sans-serif;font-size:32px;font-weight:700;color:var(--green)">
                                    ₹0
                                </div>
                            </div>
                            <span style="font-size:28px">☀️</span>
                        </div>
                        <div class="pay-row">
                            <span class="prk">Selected Plan</span>
                            <span class="prv" id="selectedPlanDisplay">—</span>
                        </div>
                    </div>

                    <div class="alert alert-i">
                        <span class="ai">ℹ</span>
                        Payment will be submitted in the next step after registration.
                        You'll be able to upload payment receipt.
                    </div>
                </div>
            </div>

            <div class="btn-row">
                <button type="button" class="btn btn-s"
                        onclick="switchTab('req',0,document.querySelectorAll('#req-tabs .tab')[0])">
                    ← Back
                </button>
                <button type="button" class="btn btn-p"
                        onclick="switchTab('req',2,document.querySelectorAll('#req-tabs .tab')[2])">
                    Next: Documents →
                </button>
            </div>
        </div>

        <!-- TAB 2: DOCUMENTS (Preview — actual upload happens after submit) -->
        <div class="tc" id="req-2">
            <div class="alert alert-i">
                <span class="ai">ℹ</span>
                Documents are uploaded after your application is submitted. Proceed to submit first.
            </div>
            <div class="btn-row">
                <button type="button" class="btn btn-s"
                        onclick="switchTab('req',1,document.querySelectorAll('#req-tabs .tab')[1])">
                    ← Back
                </button>
                <button type="button" class="btn btn-p"
                        onclick="switchTab('req',3,document.querySelectorAll('#req-tabs .tab')[3])">
                    Next: Review →
                </button>
            </div>
        </div>

        <!-- TAB 3: REVIEW & SUBMIT -->
        <div class="tc" id="req-3">
            <div class="card">
                <div class="ct"><span class="ct-dot"></span>Review Your Application</div>

                <div class="section-t">Personal Information</div>
                <div class="g2" id="review-personal">
                    <div class="sr"><span class="srk">Name</span><span class="srv" id="rev-name">—</span></div>
                    <div class="sr"><span class="srk">Mobile</span><span class="srv" id="rev-mobile">—</span></div>
                    <div class="sr"><span class="srk">Email</span><span class="srv" id="rev-email">—</span></div>
                    <div class="sr"><span class="srk">City / State</span><span class="srv" id="rev-city">—</span></div>
                </div>

                <div class="section-t" style="margin-top:14px">Product & Plan</div>
                <div class="g2">
                    <div class="sr"><span class="srk">Plan</span><span class="srv" id="rev-plan">—</span></div>
                    <div class="sr"><span class="srk">Amount</span><span class="srv" id="rev-amount">—</span></div>
                    <div class="sr"><span class="srk">Connection</span><span class="srv" id="rev-conn">—</span></div>
                    <div class="sr"><span class="srk">kV</span><span class="srv" id="rev-kv">—</span></div>
                </div>

                <div class="btn-row" style="margin-top:18px">
                    <button type="button" class="btn btn-s"
                            onclick="switchTab('req',2,document.querySelectorAll('#req-tabs .tab')[2])">
                        ← Back
                    </button>
                    <button type="submit" class="btn btn-p" id="submitBtn"
                            onclick="return confirmSubmit()">
                        ☀️ Submit Application
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function validateStep0() {
            const name = document.querySelector('[name="ApplicantName"]').value;
            const mobile = document.querySelector('[name="MobileNumber"]').value;
            if (!name || !mobile) {
                showError('Please fill Name and Mobile Number');
                return;
            }
            switchTab('req', 1, document.querySelectorAll('#req-tabs .tab')[1]);
        }

        function selectConnType(el, type) {
            el.closest('.rc-group').querySelectorAll('.rc').forEach(r => r.classList.remove('sel'));
            el.classList.add('sel');
            document.getElementById('connTypeInput').value = type === 'Domestic' ? '1' : '2';
        }

        function selectPlan(el, plan, amount) {
            el.closest('.fg').querySelectorAll('.rc').forEach(r => r.classList.remove('sel'));
            el.classList.add('sel');
            document.getElementById('selectedPlanInput').value = plan;
            document.getElementById('planAmountInput').value = amount;
            document.getElementById('planAmountDisplay').textContent = '₹' + amount.toLocaleString('en-IN');
            document.getElementById('selectedPlanDisplay').textContent = plan;
        }

        function confirmSubmit() {
            // Populate review tab
            document.getElementById('rev-name').textContent =
                document.querySelector('[name="ApplicantName"]').value;
            document.getElementById('rev-mobile').textContent =
                document.querySelector('[name="MobileNumber"]').value;
            document.getElementById('rev-email').textContent =
                document.querySelector('[name="Email"]').value;
            document.getElementById('rev-city').textContent =
                `${document.querySelector('[name="City"]').value}, ${document.querySelector('[name="State"]').value}`;
            document.getElementById('rev-plan').textContent =
                document.getElementById('selectedPlanInput').value || '—';
            document.getElementById('rev-amount').textContent =
                document.getElementById('planAmountDisplay').textContent;
            document.getElementById('rev-conn').textContent =
                document.getElementById('connTypeInput').value === '1' ? 'Domestic' : 'Commercial';
            document.getElementById('rev-kv').textContent =
                document.querySelector('[name="KVCapacity"]').value + ' kV';

            return true;
        }
    </script>
}
@model SolarPortal.Application.DTOs.SolarRequestDto?
@{
    ViewData["Title"] = "Status Tracker";

    int Pct(Domain.Enums.ProjectStatus s) => s switch
    {
        Domain.Enums.ProjectStatus.Registration => 10,
        Domain.Enums.ProjectStatus.ProductSelection => 20,
        Domain.Enums.ProjectStatus.Payment => 30,
        Domain.Enums.ProjectStatus.PMSurvey => 45,
        Domain.Enums.ProjectStatus.MeterDispatch => 60,
        Domain.Enums.ProjectStatus.MaterialDispatch => 75,
        Domain.Enums.ProjectStatus.Installation => 85,
        Domain.Enums.ProjectStatus.DCRUpdate => 95,
        Domain.Enums.ProjectStatus.Completed => 100,
        _ => 5
    };

    string StageStsClass(Domain.Enums.ProjectStatus s) => s switch
    {
        Domain.Enums.ProjectStatus.Completed => "sts-act",
        Domain.Enums.ProjectStatus.MeterDispatch => "sts-disp",
        Domain.Enums.ProjectStatus.Installation => "sts-inst",
        _ => "sts-pend"
    };
}

<div class="page active">
    <div class="ph">
        <div class="ph-bc">👤 User / <span>My Solar Status</span></div>
        <div class="ph-title">📍 Solar Status Tracker</div>
        <div class="ph-sub">Complete lifecycle of your solar connection request</div>
    </div>

    <div class="card" style="margin-bottom:16px">
        <form method="get" asp-area="User" asp-controller="SolarRequest" asp-action="Status">
            <div class="fr">
                <div class="fg">
                    <label>Application ID</label>
                    <input type="text" name="id" value="@(Model?.Id.ToString() ?? "")" placeholder="Enter project ID" />
                </div>
                <div class="fg">
                    <label>State</label>
                    <select disabled>
                        <option>@(Model?.State ?? "All")</option>
                    </select>
                </div>
            </div>
            <button type="submit" class="btn btn-p">🔍 Search</button>
        </form>
    </div>

    @if (Model != null)
    {
        <div class="g2">
            <div class="card">
                <div class="ct"><span class="ct-dot"></span>Full Status Flow</div>
                <partial name="~/Views/Shared/_StatusFlow.cshtml" model="(int)Model.CurrentStage" />
            </div>

            <div class="card">
                <div class="ct"><span class="ct-dot"></span>Project Details — @Model.RequestNumber</div>
                <div class="sr"><span class="srk">Customer</span><span class="srv">@Model.ApplicantName</span></div>
                <div class="sr"><span class="srk">Solar Type</span><span class="srv">@Model.KVCapacity kV</span></div>
                <div class="sr"><span class="srk">Connection Type</span><span class="srv">@Model.ConnectionType</span></div>
                <div class="sr"><span class="srk">Selected Plan</span><span class="srv">@(Model.SelectedPlan ?? "—")</span></div>
                <div class="sr"><span class="srk">Project Amount</span><span class="srv">₹@Model.RequestedAmount.ToString("N0")</span></div>
                <div class="sr"><span class="srk">Approved Amount</span><span class="srv">₹@Model.ApprovedAmount.ToString("N0")</span></div>
                <div class="sr"><span class="srk">Total Paid</span><span class="srv" style="color:var(--green)">₹@Model.TotalPaid.ToString("N0")</span></div>
                <div class="sr"><span class="srk">Due</span><span class="srv" style="color:var(--sun)">₹@Model.TotalDue.ToString("N0")</span></div>
                <div class="sr">
                    <span class="srk">Current Stage</span>
                    <span class="srv">
                        <span class="sts @StageStsClass(Model.CurrentStage)">@Model.CurrentStage.ToString().Replace("_", " ")</span>
                    </span>
                </div>

                <div style="margin-top:14px">
                    <div style="display:flex;justify-content:space-between;font-size:11px;margin-bottom:5px">
                        <span>Progress</span>
                        <span style="color:var(--sun)">@Pct(Model.CurrentStage)%</span>
                    </div>
                    <div class="prog-wrap">
                        <div class="prog-bar" style="width:@(Pct(Model.CurrentStage))%"></div>
                    </div>
                </div>

                <div class="btn-row">
                    @if (Model.CurrentStage == Domain.Enums.ProjectStatus.Registration ||
                         Model.CurrentStage == Domain.Enums.ProjectStatus.ProductSelection ||
                         Model.CurrentStage == Domain.Enums.ProjectStatus.Payment)
                    {
                        <a asp-area="User" asp-controller="SolarRequest" asp-action="Payment"
                           asp-route-id="@Model.Id" class="btn btn-p btn-full">💰 Continue to Payment →</a>
                    }
                    else
                    {
                        <a asp-area="User" asp-controller="Account" asp-action="SolarAccount"
                           class="btn btn-p btn-full">View Solar A/c →</a>
                    }
                </div>
            </div>
        </div>

        <div class="card" style="margin-top:16px">
            <div class="ct"><span class="ct-dot"></span>Next Steps</div>
            @switch (Model.CurrentStage)
            {
                case Domain.Enums.ProjectStatus.Registration:
                    <div class="alert alert-i"><span class="ai">📋</span>Application registered. Choose your product plan and pay the advance to continue.</div>
                    break;
                case Domain.Enums.ProjectStatus.ProductSelection:
                    <div class="alert alert-i"><span class="ai">📦</span>Plan selected. Please complete the advance payment.</div>
                    break;
                case Domain.Enums.ProjectStatus.Payment:
                    <div class="alert alert-w"><span class="ai">💰</span>Payment due — upload your payment receipt to proceed.</div>
                    break;
                case Domain.Enums.ProjectStatus.PMSurvey:
                    <div class="alert alert-i"><span class="ai">🏘️</span>PM Survey scheduled. Our team will contact you shortly.</div>
                    break;
                case Domain.Enums.ProjectStatus.MeterDispatch:
                    <div class="alert alert-i"><span class="ai">📦</span>Your meter is being dispatched.</div>
                    break;
                case Domain.Enums.ProjectStatus.MaterialDispatch:
                    <div class="alert alert-i"><span class="ai">📦</span>Solar materials being dispatched.</div>
                    break;
                case Domain.Enums.ProjectStatus.Installation:
                    <div class="alert alert-i"><span class="ai">🔧</span>Installation in progress.</div>
                    break;
                case Domain.Enums.ProjectStatus.DCRUpdate:
                    <div class="alert alert-i"><span class="ai">📄</span>DCR documentation being processed.</div>
                    break;
                case Domain.Enums.ProjectStatus.Completed:
                    <div class="alert alert-s"><span class="ai">🎉</span>Installation completed! Your solar system is active.</div>
                    break;
            }

            @if (Model.ApprovalStatus == Domain.Enums.ApprovalStatus.Rejected)
            {
                <div class="alert alert-e"><span class="ai">❌</span>Application rejected. Please contact support.</div>
            }
        </div>

        <div class="card" style="margin-top:16px">
            <div class="ct"><span class="ct-dot"></span>Need Help?</div>
            <div style="text-align:center;padding:8px;color:var(--text2)">
                <div style="margin-bottom:12px">Contact our support team for any queries about your project status</div>
                <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap">
                    <a href="tel:+919876543210" class="btn btn-s">📞 Call Support</a>
                    <a href="mailto:support@solarportal.com" class="btn btn-s">📧 Email Support</a>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="ct"><span class="ct-dot"></span>No Active Projects</div>
            <div style="text-align:center;padding:40px;color:var(--text3)">
                <div style="font-size:48px;margin-bottom:16px">📊</div>
                <div style="font-size:18px;margin-bottom:8px">No projects to track</div>
                <a asp-area="User" asp-controller="SolarRequest" asp-action="Create" class="btn btn-p" style="margin-top:16px">
                    ➕ Create New Request
                </a>
            </div>
        </div>
    }
</div>

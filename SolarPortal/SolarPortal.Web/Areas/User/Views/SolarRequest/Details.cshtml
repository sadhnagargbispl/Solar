@model SolarPortal.Application.DTOs.SolarRequestDto
@{
    ViewData["Title"] = @Model?.RequestNumber ?? "Project Details";
}

<div class="page active">
    <div class="ph">
        <div class="ph-bc">👤 User / <a asp-controller="SolarRequest" asp-action="Index" style="color:var(--sun)">Projects</a> / <span>Details</span></div>
        <div class="ph-title">📋 Request @Model?.RequestNumber</div>
        <div class="ph-sub">Your solar connection project details and status</div>
    </div>

    @if (Model != null)
    {
        <div class="g2">
            <!-- Request Info -->
            <div class="card">
                <div class="ct"><span class="ct-dot"></span>Application Details</div>
                <div class="detail-grid">
                    <div class="detail-item">
                        <span class="detail-label">Request Number</span>
                        <span class="detail-value">@Model.RequestNumber</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Approval Status</span>
                        <span class="detail-value">
                            <span class="sts @GetStatusClass(Model.ApprovalStatus)">@Model.ApprovalStatus</span>
                        </span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Connection Type</span>
                        <span class="detail-value">@Model.ConnectionType</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Applied On</span>
                        <span class="detail-value">@Model.CreatedAt.ToString("dd MMM yyyy")</span>
                    </div>
                </div>
            </div>

            <!-- System Info -->
            <div class="card">
                <div class="ct"><span class="ct-dot"></span>System Configuration</div>
                <div class="detail-grid">
                    <div class="detail-item">
                        <span class="detail-label">Capacity</span>
                        <span class="detail-value">@Model.KVCapacity kV</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Selected Plan</span>
                        <span class="detail-value">@Model.SelectedPlan</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Requested Amount</span>
                        <span class="detail-value gold">₹@Model.RequestedAmount.ToString("N0")</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Approved Amount</span>
                        <span class="detail-value green">₹@Model.ApprovedAmount.ToString("N0")</span>
                    </div>
                </div>
            </div>

            <!-- Your Info -->
            <div class="card">
                <div class="ct"><span class="ct-dot"></span>Your Information</span></div>
                <div class="detail-grid">
                    <div class="detail-item">
                        <span class="detail-label">Name</span>
                        <span class="detail-value">@Model.ApplicantName</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Mobile</span>
                        <span class="detail-value">@Model.MobileNumber</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Email</span>
                        <span class="detail-value">@Model.Email</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Location</span>
                        <span class="detail-value">@Model.City, @Model.State @Model.PinCode</span>
                    </div>
                </div>
            </div>

            <!-- Documents -->
            @if (Model.Documents.Any())
            {
                <div class="card">
                    <div class="ct"><span class="ct-dot"></span>Submitted Documents (@Model.Documents.Count)</div>
                    <div style="max-height:300px;overflow-y:auto">
                        @foreach (var doc in Model.Documents)
                        {
                            <div style="padding:12px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center">
                                <div>
                                    <div style="font-size:12px">@doc.DocumentType</div>
                                    <div style="color:var(--text2);font-size:11px">@doc.FileName</div>
                                </div>
                                <a href="@doc.FilePath" target="_blank" class="btn btn-s btn-sm">
                                    📥 Download
                                </a>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Actions -->
            <div class="card">
                <div class="ct"><span class="ct-dot"></span>Quick Actions</div>
                <div class="btn-row">
                    <a asp-controller="SolarRequest" asp-action="UploadDocuments" asp-route-id="@Model.Id"
                       class="btn btn-s">📄 Upload Documents</a>
                    @if (Model.ApprovalStatus.ToString() == "Approved")
                    {
                        <a asp-controller="SolarRequest" asp-action="Payment" asp-route-id="@Model.Id"
                           class="btn btn-p" style="margin-left:4px">💰 Make Payment</a>
                    }
                </div>
            </div>
        </div>

        <!-- Status Flow -->
        <div class="card" style="margin-top:20px">
            <div class="ct"><span class="ct-dot"></span>Project Status Flow</div>
            <partial name="~/Views/Shared/_StatusFlow.cshtml" model="(int)Model.CurrentStage" />
        </div>
    }
    else
    {
        <div class="card">
            <div style="text-align:center;padding:40px;color:var(--text3)">Project not found</div>
        </div>
    }
</div>

<style>
.detail-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
    padding: 0;
}

.detail-item {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.detail-label {
    font-size: 12px;
    color: var(--text2);
    text-transform: uppercase;
    font-weight: 600;
    letter-spacing: 0.5px;
}

.detail-value {
    font-size: 16px;
    color: var(--text1);
    font-weight: 500;
}

.detail-value.gold {
    color: var(--sun);
}

.detail-value.green {
    color: var(--succ);
}
</style>

@functions {
    string GetStatusClass(Domain.Enums.ApprovalStatus status) => status switch
    {
        Domain.Enums.ApprovalStatus.Pending => "sts-pend",
        Domain.Enums.ApprovalStatus.Approved => "sts-act",
        Domain.Enums.ApprovalStatus.Rejected => "sts-rej",
        _ => "sts-pend"
    };
}

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    string IsActive(string ctrl) => currentController == ctrl ? "active" : "";
}

<div class="sb-section">
    <div class="sb-label">Admin Menu</div>
    <a class="sb-item @IsActive("Dashboard")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
        <span class="sbi">📊</span>Dashboard
    </a>
    <a class="sb-item @IsActive("Projects")" asp-area="Admin" asp-controller="Projects" asp-action="Index">
        <span class="sbi">🏗️</span>All Projects
        <span class="sb-badge" id="total-badge">--</span>
    </a>
    <a class="sb-item @IsActive("Approvals")" asp-area="Admin" asp-controller="Projects" asp-action="Approvals">
        <span class="sbi">✅</span>Approvals
        <span class="sb-badge red" id="approval-badge">--</span>
    </a>
</div>
<div class="sb-section">
    <div class="sb-label">Operations</div>
    <a class="sb-item" asp-area="Admin" asp-controller="Operations" asp-action="MeterDispatch">
        <span class="sbi">⚡</span>Meter Dispatch
    </a>
    <a class="sb-item" asp-area="Admin" asp-controller="Operations" asp-action="SiteSurvey">
        <span class="sbi">🗺️</span>Site Survey
    </a>
    <a class="sb-item" asp-area="Admin" asp-controller="Operations" asp-action="MaterialDispatch">
        <span class="sbi">📦</span>Solar Material
    </a>
    <a class="sb-item" asp-area="Admin" asp-controller="Operations" asp-action="Installation">
        <span class="sbi">🔧</span>Installation
    </a>
    <a class="sb-item" asp-area="Admin" asp-controller="Operations" asp-action="DCRUpdate">
        <span class="sbi">📋</span>DCR Update
    </a>
</div>
<div class="sb-section">
    <div class="sb-label">Management</div>
    <a class="sb-item @IsActive("Workers")" asp-area="Admin" asp-controller="Workers" asp-action="Index">
        <span class="sbi">👷</span>Installers
    </a>
    <a class="sb-item" asp-area="Admin" asp-controller="Commission" asp-action="Index">
        <span class="sbi">📈</span>INC Commission
    </a>
    <a class="sb-item" asp-area="Admin" asp-controller="Settings" asp-action="Index">
        <span class="sbi">⚙️</span>Settings
    </a>
</div>
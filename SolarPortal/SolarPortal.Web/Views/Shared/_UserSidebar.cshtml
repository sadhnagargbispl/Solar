@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    string IsActive(string ctrl, string? action = null) =>
        currentController == ctrl && (action == null || currentAction == action) ? "active" : "";
}

<div class="sb-section">
    <div class="sb-label">User Menu</div>
    <a class="sb-item @IsActive("Dashboard")" asp-area="SolarPanelUserPanel" asp-controller="Dashboard" asp-action="Index">
        <span class="sbi">📊</span>Dashboard
    </a>
    <a class="sb-item @IsActive("SolarRequest","Status")" asp-area="SolarPanelUserPanel" asp-controller="SolarRequest" asp-action="Status">
        <span class="sbi">📍</span>My Solar Status
    </a>
    <a class="sb-item @IsActive("SolarRequest","Create")" asp-area="SolarPanelUserPanel" asp-controller="SolarRequest" asp-action="Create">
        <span class="sbi">➕</span>New Request
        <span class="sb-badge">New</span>
    </a>
</div>
<div class="sb-section">
    <div class="sb-label">My Applications</div>
    @* "My Projects" (SolarRequest/Index) removed from the menu on request. The
       action still exists - Details pages and breadcrumbs keep working. *@
    <a class="sb-item" asp-area="SolarPanelUserPanel" asp-controller="Account" asp-action="SolarAccount">
        <span class="sbi">💰</span>Solar A/c
    </a>
</div>
<div class="sb-section">
    <div class="sb-label">Workflow</div>
    <a class="sb-item @IsActive("PMSurya")" asp-area="SolarPanelUserPanel" asp-controller="PMSurya" asp-action="Upload">
        <span class="sbi">📋</span>PM Surya Ghar
    </a>
    <a class="sb-item @IsActive("SiteSurvey")" asp-area="SolarPanelUserPanel" asp-controller="SiteSurvey" asp-action="Index">
        <span class="sbi">📐</span>Site Survey
    </a>
    @* DCR Upload removed from the user side - the DCR is uploaded by the ADMIN
       panel now. The DCR stage still shows on the status timeline so the user can
       see where the project is, and past DCR records stay visible under Reports. *@
    @* Opens once the plan is PAID IN FULL and the INSTALLATION is complete - an
       approved solar request alone is not enough. The controller redirects with a
       message if it is not open yet. *@
    <a class="sb-item @IsActive("RemainingBv","Index")" asp-area="SolarPanelUserPanel" asp-controller="RemainingBv" asp-action="Index">
        <span class="sbi">⚖️</span>Update Remaining BV
    </a>
</div>
<div class="sb-section">
    @* Reports page added per spec: user sees full history of submissions
       across all modules (payments, PM Surya, site survey, dispatch ops,
       DCR) with their current status — Pending / Approved / Rejected. *@
    <div class="sb-label">Reports</div>
    <a class="sb-item @IsActive("Reports")" asp-area="SolarPanelUserPanel" asp-controller="Reports" asp-action="Index">
        <span class="sbi">📊</span>My Reports
    </a>
    <a class="sb-item @IsActive("RemainingBv","Report")" asp-area="SolarPanelUserPanel" asp-controller="RemainingBv" asp-action="Report">
        <span class="sbi">⚖️</span>Remaining BV Report
    </a>
</div>

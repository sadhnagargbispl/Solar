@model LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    var panel = (ViewBag.Panel as string) ?? "user";
    var isInc = panel == "inc";
}

<style>
    .auth-tabs { display:flex; gap:8px; margin-bottom:18px; background:#f1f5f9; padding:5px; border-radius:10px }
    .auth-tab { flex:1; text-align:center; padding:9px 10px; border-radius:7px; font-size:13px; font-weight:600;
                color:#64748b; text-decoration:none; transition:all .15s ease }
    .auth-tab:hover { color:#0f172a }
    .auth-tab.active { background:#fff; color:var(--accent-dark); box-shadow:0 1px 3px rgba(0,0,0,.1) }
</style>

<div class="auth-card">
    <div class="auth-logo">
        <div class="brand-logo-lg">☀️</div>
        <h1 class="auth-title">SOLAR PORTAL</h1>
        <p class="auth-sub">@(isInc ? "Sign in to the INC / Installer panel" : "Sign in to your account")</p>
    </div>

    <div class="auth-tabs">
        <a class="auth-tab @(isInc ? "" : "active")" href="@Url.Action("Login", "Account", new { panel = "user" })">&#128100; User Panel</a>
        <a class="auth-tab @(isInc ? "active" : "")" href="@Url.Action("Login", "Account", new { panel = "inc" })">&#128736; INC Panel</a>
    </div>

    <form asp-action="Login" method="post" id="loginForm">
        <input type="hidden" asp-for="ReturnUrl" />
        <input type="hidden" name="panel" value="@panel" />
        <div class="fg">
            <label asp-for="Email">@(isInc ? "INC / Installer ID" : "Member ID")</label>
            <input asp-for="Email" type="text" placeholder="@(isInc ? "Your INC login ID / email" : "Your Member ID")" autocomplete="username" />
            <span asp-validation-for="Email" class="text-danger" style="font-size:11px"></span>
        </div>
        <div class="fg">
            <label asp-for="Password">Password</label>
            <div class="ig">
                <input asp-for="Password" type="password" placeholder="Enter password" id="passwordInput" />
                <button type="button" class="pass-toggle" onclick="togglePass()">👁</button>
            </div>
            <span asp-validation-for="Password" class="text-danger" style="font-size:11px"></span>
        </div>
        <div class="fg" style="display:flex;justify-content:space-between;align-items:center">
            <label style="display:flex;gap:7px;align-items:center;cursor:pointer;margin-bottom:0">
                <input asp-for="RememberMe" type="checkbox" style="width:auto" />
                <span style="font-size:12px;color:var(--text2)">Remember me</span>
            </label>
            <a asp-action="ForgotPassword" style="font-size:12px;color:var(--sun)">Forgot password?</a>
        </div>
        <button type="submit" class="btn btn-p btn-full" style="margin-top:4px">
            @(isInc ? "Sign In to INC Panel" : "☀️ Sign In")
        </button>
    </form>

   @*  <div style="text-align:center;margin-top:20px;font-size:13px;color:var(--text3)">
        Don't have an account?
        <a asp-action="Register" style="color:var(--sun)">Register here</a>
    </div>

    <div class="demo-creds">
        <div style="font-size:11px;color:var(--text3);margin-bottom:6px">Demo Credentials:</div>
        <div style="font-size:11px;display:flex;gap:12px;flex-wrap:wrap">
            <span>👤 user@solarportal.com / User@1234</span>
            <span>🛡️ admin@solarportal.com / Admin@1234</span>
        </div>
    </div> *@
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePass() {
            const input = document.getElementById('passwordInput');
            input.type = input.type === 'password' ? 'text' : 'password';
        }
    </script>
}
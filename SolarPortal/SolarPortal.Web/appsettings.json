{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=SolarPortalDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "FileUpload": {
    "MaxFileSizeMB": 10,
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".pdf" ],
    "UploadPath": "wwwroot/uploads"
  },
  "Identity": {
    "PasswordRequireDigit": true,
    "PasswordRequiredLength": 8,
    "PasswordRequireNonAlphanumeric": false,
    "PasswordRequireUppercase": false
  }
}